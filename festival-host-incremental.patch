+  const controls=[...document.querySelectorAll('button,summary,.check-label')].filter(e=>visible(e)&&!e.closest('[hidden]')&&![...document.querySelectorAll('details:not([open])')].some(d=>d.contains(e)&&d.querySelector(':scope>summary')!==e));

+test('holding plans a nearby walk without teleporting or planting a remote neighbour',()=>{const {s,life,calls,position}=setup(),start={...position};life.handle('plant',{phase:'start'});life.advance(1);assert.equal(calls.length,1);assert.equal(life.state().travelling,true);assert.deepEqual(position,start);assert.equal(s.plots[1].phase,'empty');life.handle('plant',{phase:'release',assist:false});assert.equal(life.state().travelling,false);life.advance(5);assert.equal(calls.length,1);});
+test('menu boundaries and helper replacement cancel before a transaction',()=>{for(const mode of ['menu','helper']){const {s,life,calls,close}=setup();life.handle('plant',{phase:'tap'});life.advance(.2);if(mode==='menu')close();else M.plant(s,0);life.advance(2);assert.equal(calls.length,0);assert.equal(life.state().active,false);}});

+test('a short tap assists one job, commits after its duration and never repeats',()=>{const {s,life,calls}=setup();assert.equal(life.handle('plant',{phase:'start'}),true);life.handle('plant',{phase:'release',assist:true});life.advance(.35);assert.equal(s.plots[0].phase,'empty');life.advance(1);assert.equal(s.plots[0].phase,'growing');life.advance(5);assert.equal(calls.length,1);assert.equal(life.state().active,false);});

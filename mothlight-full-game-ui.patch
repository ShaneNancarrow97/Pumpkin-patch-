diff --git a/voxel/docs/contractor-patches/mothlight-game-ui/theme.css b/voxel/docs/contractor-patches/mothlight-game-ui/theme.css
new file mode 100644
index 0000000000000000000000000000000000000000..515f7bc5a4cdc9e901263dcae775f11051fe8a14
--- /dev/null
+++ b/voxel/docs/contractor-patches/mothlight-game-ui/theme.css
@@ -0,0 +1,55 @@
+/* Mothlight: a visual skin on the real game. World, input, prices and saves are unchanged. */
+@font-face{font-family:'Mothlight Hand';src:url('mothlight:caveat') format('woff2');font-weight:400;font-display:swap}
+.mothlight-game .hud,.mothlight-game .dock{background:linear-gradient(160deg,#302332ed,#1d1725f5);border-color:#b5977938;box-shadow:0 7px 24px #09061050,inset 0 1px #dec7ad0d}
+.mothlight-game .tab.active{color:#e8cc9b;background:linear-gradient(180deg,#b79a6b18,transparent),linear-gradient(90deg,transparent,#bfa17d,transparent) no-repeat 50% 100%/44% 2px}
+.mothlight-game :is(.sheet,.upgrade-menu,.intro,.level-celebration){--panel:#45364d;--panel-glass:#45364dfa;--raised:#7d5b8928;--edge:#c5a8bd45;--edge-soft:#b99cba30;--ink:#f1e6d7;--ink-soft:#d5c4dc;--brass:#c7a779;--gold:#e1bd7f;--gold-bright:#f0d3a2;--purchase-top:#e2c38d;--purchase-bottom:#c19a67;--purchase-ink:#352419;--moss:#bad0a7;color:var(--ink);color-scheme:dark}
+body.mothlight-game #sheet.sheet .sheet-frame{border:6px solid #291e31;border-radius:16px;outline:1px solid #cfb08a70;outline-offset:-7px;padding:19px 23px 17px;background:repeating-linear-gradient(0deg,#e8d2f006 0,#e8d2f006 1px,transparent 1px,transparent 4px),radial-gradient(ellipse at 100% 100%,#a47fb124,transparent 60%),linear-gradient(90deg,#33253c,#47364e 5%,#4b3853 94%,#35263e);box-shadow:inset 8px 0 14px #100b1829,0 18px 65px #05030890;isolation:isolate;background-color:#45364d}
+body.mothlight-game #sheet.sheet .sheet-frame::before{content:'';position:absolute;inset:8px;z-index:-1;border:1px solid #d7bb952c;border-radius:8px;pointer-events:none;box-shadow:inset 0 1px #ffffff0c}
+body.mothlight-game #sheet.sheet .sheet-frame::after{content:'';position:absolute;right:-3px;bottom:5px;width:46px;height:110px;background:url('mothlight:botanical') center/contain no-repeat;opacity:.27;pointer-events:none;z-index:1}

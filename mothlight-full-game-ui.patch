diff --git a/voxel/docs/contractor-patches/mothlight-game-ui/theme.css b/voxel/docs/contractor-patches/mothlight-game-ui/theme.css
new file mode 100644
index 0000000000000000000000000000000000000000..36201d5a5e7e3bbd4559b89a26c343a2d4afdc04
--- /dev/null
+++ b/voxel/docs/contractor-patches/mothlight-game-ui/theme.css
@@ -0,0 +1,50 @@
+/* Mothlight: a visual skin on the real game. World, input, prices and saves are unchanged. */
+@font-face{font-family:'Mothlight Hand';src:url('mothlight:caveat') format('woff2');font-weight:400;font-display:swap}
+.mothlight-game .hud,.mothlight-game .dock{background:linear-gradient(160deg,#302332ed,#1d1725f5);border-color:#b5977938;box-shadow:0 7px 24px #09061050,inset 0 1px #dec7ad0d}
+.mothlight-game .tab.active{color:#e8cc9b;background:linear-gradient(180deg,#b79a6b18,transparent),linear-gradient(90deg,transparent,#bfa17d,transparent) no-repeat 50% 100%/44% 2px}
+.mothlight-game :is(.sheet,.upgrade-menu,.intro,.level-celebration){--panel:#ddcbac;--panel-glass:#e0cfb3fa;--raised:#c7b2b92e;--edge:#8d6c704d;--edge-soft:#8e6d7430;--ink:#453047;--ink-soft:#674c62;--brass:#8b6743;--gold:#765231;--gold-bright:#77502f;--purchase-top:#dec18e;--purchase-bottom:#c8a26c;--purchase-ink:#372318;--moss:#56674a;color:var(--ink);color-scheme:light}
+body.mothlight-game #sheet.sheet .sheet-frame{border:6px solid #51394c;border-radius:16px;outline:1px solid #bda48680;outline-offset:-7px;padding:19px 23px 17px;background:repeating-linear-gradient(0deg,#76533004 0,#76533004 1px,transparent 1px,transparent 4px),radial-gradient(ellipse at 100% 100%,#b28f5430,transparent 60%),linear-gradient(90deg,#c4ad8c,#e4d3b4 5%,#e7d8bd 94%,#cdb58f);box-shadow:inset 8px 0 14px #7b5a3826,0 18px 65px #05030890;isolation:isolate}
+body.mothlight-game #sheet.sheet .sheet-frame::before{content:'';position:absolute;inset:8px;z-index:-1;border:1px solid #80604426;border-radius:8px;pointer-events:none;box-shadow:inset 0 1px #fff5}
+body.mothlight-game #sheet.sheet .sheet-frame::after{content:'';position:absolute;right:-3px;bottom:5px;width:46px;height:110px;background:url('mothlight:botanical') center/contain no-repeat;opacity:.27;pointer-events:none;z-index:1}
+body.mothlight-game #sheet.sheet .sheet-head{position:relative;border-bottom-color:#84604435;padding:0 2px 24px}
+body.mothlight-game #sheet.sheet .sheet-head::before{content:'';position:absolute;right:45px;top:-14px;width:74px;height:57px;background:url('mothlight:moth') center/contain no-repeat;opacity:.25;pointer-events:none;z-index:-1;transform:rotate(9deg)}
+body.mothlight-game #sheet.sheet:not(:has(.service-hero)) .sheet-head::after{content:'a little autumn magic, kept here';position:absolute;bottom:4px;left:2px;font:20px/1 'Mothlight Hand',cursive;color:#80627a;pointer-events:none;transform:rotate(-2deg)}

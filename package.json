{
  "name": "pumpkin-patch",
  "version": "3.0.0",
  "private": true,
  "description": "Shane & Natalie's Pumpkin Patch: a cosy Halloween farm and shop game that ships as one offline HTML file.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev",
    "test": "node --test \"test/**/*.test.mjs\"",
    "check": "npm test && npm run build && npm run smoke",
    "sim": "node scripts/simulate.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:android": "node scripts/build.mjs --android"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "playwright": "1.49.1"
  },
  "engines": {
    "node": ">=20"
  }
}

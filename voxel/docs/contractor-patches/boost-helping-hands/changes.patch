 import test from "node:test";import assert from "node:assert/strict";import * as M from "../src/model.js";import {VISITOR_KINDS} from "../src/content/visitors.js";
 test("dedicated barn upgrades are paid, increase space, and survive a save without erasing existing stock",()=>{const s=M.freshState();s.coins=1e6;s.earned = 2e6; s.progression.claimed = M.LEVELS.map((l) => l.level); let capacity=M.barnCapacity(s);for(let i=0;i<6;i++){const cash=s.coins;assert.ok(M.buyUpgrade(s,"storage"));assert.ok(s.coins<cash);assert.ok(M.barnCapacity(s)>capacity);capacity=M.barnCapacity(s);}assert.equal(M.buyUpgrade(s,"storage"),false);s.stock=[10000,2,3,4];const r=M.restoreState(JSON.parse(JSON.stringify(M.saveData(s))));assert.deepEqual(r.stock,[...s.stock,...Array(Math.max(0,M.VARIETIES.length-s.stock.length)).fill(0)]);assert.equal(r.upgrades.storage,6);assert.equal(M.harvest(r,0),0);});
-test("a full barn stops helpers and tap bonuses without losing a ripe crop or minting money",()=>{const s=M.freshState();const cap=M.barnCapacity(s);s.stock=[cap,0,0,0];s.upgrades.auto=1;s.visitorTimer=s.shop.arrivalTimer=1e6;s.plots[0]={phase:"ready",progress:1,variety:3,ripe:0};s.time=20;const coins=s.coins;M.update(s,3);assert.equal(s.plots[0].phase,"ready");for(let i=0;i<16;i++){s.time+=.2;M.tap(s);}assert.equal(s.coins,coins);assert.equal(s.harvested,0);assert.equal(M.stockCount(s),cap);});
+test("a full barn stops helpers and tap bonuses without losing a ripe crop or minting money",()=>{const s=M.freshState();const cap=M.barnCapacity(s);s.stock=[cap,0,0,0];s.upgrades.auto=1;M.grantLegacyHelpers(s);s.visitorTimer=s.shop.arrivalTimer=1e6;s.plots[0]={phase:"ready",progress:1,variety:3,ripe:0};s.time=20;const coins=s.coins;M.update(s,3);assert.equal(s.plots[0].phase,"ready");for(let i=0;i<16;i++){s.time+=.2;M.tap(s);}assert.equal(s.coins,coins);assert.equal(s.harvested,0);assert.equal(M.stockCount(s),cap);});
 test("outdoor crowd capacity grows from sixteen to fifty, with saved tiers",()=>{const s=M.freshState();s.coins=1e7;s.earned = 2e6; s.progression.claimed = M.LEVELS.map((l) => l.level); s.visitorUpgrades.party=1;assert.equal(M.visitorCapacity(s),16);const caps=[20,24,28,32,38,44,50];for(const cap of caps){assert.ok(M.buyVisitorUpgrade(s,"crowd"));assert.equal(M.visitorCapacity(s),cap);}assert.equal(M.buyVisitorUpgrade(s,"crowd"),false);const r=M.restoreState(JSON.parse(JSON.stringify(M.saveData(s))));assert.equal(M.visitorCapacity(r),50);const old=M.freshState();old.visitorUpgrades.crowd=4;assert.equal(M.visitorCapacity(M.restoreState(JSON.parse(JSON.stringify(M.saveData(old))))),32,"a save at the old top keeps its thirty-two");});
 test("eleven stable visitor kinds preserve the original ten alongside the rare Baron",()=>{assert.deepEqual(VISITOR_KINDS.slice(0,5),["ghost","witch","vampire","skeleton","scarecrow"]);assert.deepEqual(VISITOR_KINDS.slice(5,10),["mummy","zombie","werewolf","dead-pirate","clown"]);assert.equal(VISITOR_KINDS[10],"baron");for(let kind=5;kind<10;kind++){const s=M.freshState();s.nextVisitor=kind;s.visitorTimer=.01;M.update(s,.1);assert.equal(s.visitors[0].kind,kind);}});

+  work.boost.overheated = work.boost.heat >= BOOST_HEAT.capacity || b?.overheated === true && work.boost.heat > BOOST_HEAT.recoverAt;
+  work.boost.lastUse = finite(b?.lastUse, -1, Math.max(0, s.time), -1);

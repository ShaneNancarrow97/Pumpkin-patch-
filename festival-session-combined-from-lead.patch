index 0000000000000000000000000000000000000000..f62d6c606453356ce48555519e9b179b5f84cdb9
--- /dev/null
+++ b/voxel/docs/contractor-patches/late-game-support/test/art.test.mjs
@@ -0,0 +1,32 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {createHash} from 'node:crypto';
+
+test('six distinct reference icons retain their reviewed file and mobile dimensions',()=>{
+ const meta=JSON.parse(fs.readFileSync(new URL('../art/manifest.json',import.meta.url)));
+ const bytes=fs.readFileSync(new URL('../art/menu-icons.webp',import.meta.url));
+ assert.equal(meta.installedInGame,false);
+ assert.equal(meta.icons.length,6);
+ assert.equal(new Set(meta.icons.map(i=>i.id)).size,6);
+ assert.equal(new Set(meta.icons.map(i=>i.rgbaSHA256)).size,6);
+ assert.equal(createHash('sha256').update(bytes).digest('hex'),meta.encodedSHA256);
+ assert.equal(bytes.length,meta.encodedBytes);
+ assert.ok(bytes.length<220*1024);
+ assert.equal(bytes.toString('ascii',0,4),'RIFF');
+ assert.equal(bytes.toString('ascii',8,12),'WEBP');
+ assert.equal(bytes.readUInt32LE(4)+8,bytes.length);
+ let dims;
+ for(let p=12;p+8<=bytes.length;){
+  const tag=bytes.toString('ascii',p,p+4),length=bytes.readUInt32LE(p+4),start=p+8;
+  assert.ok(start+length<=bytes.length);
+  if(tag==='VP8X'){dims=[1+bytes.readUIntLE(start+4,3),1+bytes.readUIntLE(start+7,3)];break;}
+  p+=8+length+length%2;
+ }
+ assert.deepEqual(dims,[meta.columns*meta.cell,meta.rows*meta.cell]);
+ for(const cell of meta.icons){
+  assert.ok(cell.column>=0&&cell.column<3&&cell.row>=0&&cell.row<2);
+  const [x0,y0,x1,y1]=cell.packedBounds;
+  assert.ok(x0>=6&&y0>=6&&x1<=186&&y1<=186,'clear gutter around '+cell.id);
+ }
+});
diff --git a/voxel/docs/contractor-patches/late-game-support/test/audit.test.mjs b/voxel/docs/contractor-patches/late-game-support/test/audit.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d900bbdcc0302c4f04f637d68d24d028ceee78da
--- /dev/null
+++ b/voxel/docs/contractor-patches/late-game-support/test/audit.test.mjs
@@ -0,0 +1,115 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { createHash } from 'node:crypto';
+import { runAttractionAudit, runAttractionScenario } from '../tools/audit-attractions.mjs';
+
+test('matched inputs produce a reproducible 18-case study with source fingerprints', () => {
+  const options = Object.freeze({ durationSeconds: 240 });
+  const a = runAttractionAudit(options), b = runAttractionAudit(options);
+  assert.deepEqual(a, b);
+  assert.equal(a.scenarios.length, 18);
+  assert.equal(new Set(a.scenarios.map(s => s.id)).size, 18);
+  assert.equal(a.summary.ledgerBalanced, true);
+  assert.match(a.scope, /not whole-farm profit/);
+  assert.equal(a.options.acceptance, 'capacity');
+  assert.ok(a.assumptions.some(text => text.includes('forces the willingness/value roll only')));
+  assert.ok(Object.keys(a.sourceHashes).length > 50, 'capture shared rules/content, not only immediate ride imports');
+  assert.ok(Object.hasOwn(a.sourceHashes, 'src/core/costume-model.mjs'), 'include shared repository dependencies of the model');
+  assert.equal(Object.hasOwn(a.sourceHashes, 'voxel/src/content/directional-atlas.js'), false, 'unrelated contractor sprite content must not tie the pack to another branch');
+  assert.equal(Object.hasOwn(a.sourceHashes, 'voxel/src/content/hayride-icon-map.js'), false, 'unrelated renderer content is not an audit input');
+  const key = 'voxel/src/rules/hayride.js';
+  const bytes = readFileSync(new URL('../../../../src/rules/hayride.js', import.meta.url));
+  assert.equal(a.sourceHashes[key], createHash('sha256').update(bytes).digest('hex'));
+  assert.deepEqual([...new Set(a.scenarios.map(s => s.metrics.offered))], [32]);
+  assert.ok(a.scenarios.every(s => s.config.invitationsActuallySimulated === false));
+});
+
+test('actual ticket transactions conserve finite wallets and capital is kept separate', () => {
+  const result = runAttractionScenario({ routeLevel: 2, fleet: 2, ticketPrice: 12 }, { durationSeconds: 600, guestBudget: 60.1 });
+  const { config: c, metrics: m, ledger: l } = result;
+  assert.ok(m.ticketsSold > 0 && c.capitalInvested > m.ticketRevenue);
+  assert.equal(m.ticketRevenue, m.ticketsSold * c.ticketPrice);
+  assert.equal(m.ticketRevenue, l.walletDebits);
+  assert.equal(m.ticketRevenue, l.saleEventTotal);
+  assert.equal(m.ticketRevenue, l.coinIncreaseAfterCapital);
+  assert.equal(m.ticketRevenue, l.earnedIncrease);
+  assert.equal(m.ticketsSold, l.uniqueChargedVisitors);
+  assert.equal(m.ticketsSold, l.uniqueVisitReceipts);
+  assert.ok(Math.abs(l.offeredWalletTotal - m.remainingGuestMoney - m.ticketRevenue) < 1e-6);
+  assert.ok(m.completed <= m.ticketsSold && m.paidReturnedGuests <= m.completed);
+  assert.equal(m.meanPaidGuestRemainder, 48.1);
+  assert.equal(m.ledgerBalanced, true);
+});
+
+test('forced capacity acceptance does not bypass an insufficient guest budget', () => {
+  const result = runAttractionScenario({ fleet: 2, ticketPrice: 12 }, { durationSeconds: 300, guestBudget: 10 });
+  assert.ok(result.metrics.offered > 0);
+  assert.equal(result.metrics.accepted, 0);
+  assert.equal(result.metrics.refusedBudget, result.metrics.offered);
+  assert.equal(result.metrics.ticketsSold, 0);
+  assert.equal(result.metrics.ticketRevenue, 0);
+  assert.equal(result.metrics.ledgerBalanced, true);
+});
+
+test('ordinary walk-in mode preserves willingness/value choices', () => {
+  const config = { routeLevel: 0, fleet: 2, ticketPrice: 12 };
+  const capacity = runAttractionScenario(config, { durationSeconds: 600 });
+  const walkIn = runAttractionScenario(config, { durationSeconds: 600, acceptance: 'walk-in' });
+  assert.equal(walkIn.metrics.offered, capacity.metrics.offered);
+  assert.ok(walkIn.metrics.refusedWillingnessOrValue > 0);
+  assert.ok(walkIn.metrics.accepted < capacity.metrics.accepted);
+  assert.equal(walkIn.metrics.ledgerBalanced, true);
+});
+
+test('event-aligned half-second and one-second steps preserve outcomes', () => {
+  const config = Object.freeze({ routeLevel: 2, fleet: 2, ticketPrice: 12 });
+  const a = runAttractionScenario(config, { durationSeconds: 600, stepSeconds: 1 });
+  const b = runAttractionScenario(config, { durationSeconds: 600, stepSeconds: .5 });
+  assert.deepEqual(a, b);
+});
+
+test('the ledger remains complete after the live ride truncates its receipt history', () => {
+  const r = runAttractionScenario({ fleet: 2, ticketPrice: 8 }, { durationSeconds: 3600, arrivalEverySeconds: 10, partySize: 8 });
+  assert.ok(r.metrics.ticketsSold > 256);
+  assert.equal(r.ledger.retainedRuntimeReceipts, 256);
+  assert.equal(r.ledger.uniqueVisitReceipts, r.metrics.ticketsSold);
+  assert.equal(r.ledger.saleEventTotal, r.metrics.ticketRevenue);
+  assert.equal(r.metrics.ledgerBalanced, true);
+});
+
+test('paid departures and completed returns are kept distinct at the horizon', () => {
+  const r = runAttractionScenario({ fleet: 2, ticketPrice: 8 }, { durationSeconds: 60 });
+  assert.ok(r.metrics.ticketsSold > 0);
+  assert.equal(r.metrics.completed, 0);
+  assert.equal(r.metrics.paidReturnedGuests, 0);
+  assert.ok(r.metrics.chargedActiveAtEnd > 0);
+});
+
+test('route warnings are conditional evidence and the original circuit is not mislabelled', () => {
+  const report = runAttractionAudit({ durationSeconds: 300 });
+  const baseline = report.scenarios.find(s => s.id === 'route-0-fleet-1-ticket-12');
+  const detour = report.scenarios.find(s => s.id === 'route-2-fleet-1-ticket-12');
+  assert.equal(baseline.warnings.some(w => w.code === 'route-scare-saturated'), false);
+  if (detour.config.scareRating <= baseline.config.scareRating && report.staticFacts.routes[2].ticketRange.max <= report.staticFacts.routes[0].ticketRange.max && detour.config.circuitSeconds > baseline.config.circuitSeconds) {
+    assert.equal(detour.warnings.some(w => w.code === 'route-scare-saturated'), true);
+  }
+  const comparisons = report.findings.find(f => f.id === 'route-payoff-at-scare-cap').comparisons;
+  assert.equal(comparisons.length, 12);
+  for (const c of comparisons) {
+    const base = report.scenarios.find(s => s.id === c.baselineId), candidate = report.scenarios.find(s => s.id === c.scenarioId);
+    assert.equal(base.config.fleet, candidate.config.fleet);
+    assert.equal(base.config.ticketPrice, candidate.config.ticketPrice);
+    assert.equal(base.metrics.offered, candidate.metrics.offered);
+    assert.equal(c.completionDelta, candidate.metrics.completed - base.metrics.completed);
+    assert.equal(c.revenueDelta, candidate.metrics.ticketRevenue - base.metrics.ticketRevenue);
+  }
+});
+
+test('invalid or accidentally enormous studies are rejected without running fixtures', () => {
+  for (const options of [{ stepSeconds: 0 }, { durationSeconds: -1 }, { guestBudget: NaN }, { acceptance: 'all-win' }, { partySize: 21 }, { unknownOption: true }, { durationSeconds: 86400, arrivalEverySeconds: .1, partySize: 20 }]) assert.throws(() => runAttractionAudit(options));
+  assert.throws(() => runAttractionAudit(null));
+  assert.throws(() => runAttractionScenario({ routeLevel: 3 }));
+  assert.throws(() => runAttractionScenario({ fleet: 3 }));
+  assert.throws(() => runAttractionScenario({ ticketPrice: 500 }));
+});
diff --git a/voxel/docs/contractor-patches/late-game-support/test/content.test.mjs b/voxel/docs/contractor-patches/late-game-support/test/content.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0c7b760143cab3fc10e3ce33117d6a5853e2d169
--- /dev/null
+++ b/voxel/docs/contractor-patches/late-game-support/test/content.test.mjs
@@ -0,0 +1,140 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { RECIPES, COOKING } from '../../../../src/content/cooking.js';
+import { KITCHEN_EQUIPMENT, KITCHEN_CAPABILITIES } from '../../../../src/content/kitchen-equipment.js';
+import { VISITOR_EVENT_UPGRADES } from '../../../../src/content/visitor-events.js';
+import { HAYRIDE_PROPERTY, HAYRIDE_TIERS, HAYRIDE_ROUTE_UPGRADES } from '../../../../src/content/hayride.js';
+import { HOLLOW_PROPERTY, FOYER_TIERS } from '../../../../src/content/hollow-house.js';
+import { COCOA_TIERS } from '../../../../src/content/festival-meadow.js';
+import { COCOA_SPECIALS } from '../../../../src/rules/cocoa-menu.js';
+import { ESTATE_DECOR } from '../../../../src/content/house-estate.js';
+import { UNLOCKS } from '../../../../src/rules/unlocks.js';
+import { decorById } from '../../../../src/rules/house.js';
+
+const content = JSON.parse(readFileSync(new URL('../data/festival-themes.json', import.meta.url), 'utf8'));
+const byId = list => new Map(list.map(item => [item.id, item]));
+const recipes = byId(RECIPES), equipment = byId(KITCHEN_EQUIPMENT), events = byId(VISITOR_EVENT_UPGRADES), garden = byId(ESTATE_DECOR), specials = byId(COCOA_SPECIALS);
+
+test('the content is an isolated proposal with unregistered cosmetic rewards', () => {
+  assert.equal(content.status, 'proposal');
+  assert.equal(content.integrationStatus, 'not-installed');
+  assert.equal(new Set(content.themes.map(t => t.id)).size, content.themes.length);
+  assert.equal(new Set(content.rewards.map(r => r.id)).size, content.rewards.length);
+  for (const reward of content.rewards) {
+    assert.match(reward.id, /^contract-trophy-/);
+    assert.equal(reward.integrationStatus, 'not-registered');
+    assert.equal(reward.kind, 'cosmetic-floor-prop');
+    assert.deepEqual(reward.mechanicalEffects, []);
+    assert.ok(!Object.hasOwn(decorById, reward.id), `${reward.id} unexpectedly became live content; update the integration claim`);
+    assert.equal(content.themes.filter(t => t.rewardId === reward.id).length, 1, `${reward.id} must belong to exactly one evening`);
+  }
+});
+
+test('every themed menu uses attainable existing recipes and physical kitchen equipment', () => {
+  for (const theme of content.themes) {
+    assert.equal(theme.recipeIds.length, 2, `${theme.id}: current shop has two food displays`);
+    assert.equal(new Set(theme.recipeIds).size, 2);
+    assert.ok(COOKING.level <= theme.level);
+    const grants = new Set(theme.prerequisites.suggestedKitchenEquipmentIds.flatMap(id => {
+      assert.ok(equipment.has(id), `${theme.id}: missing equipment ${id}`);
+      return equipment.get(id).grants;
+    }));
+    for (const capability of theme.prerequisites.kitchenCapabilities) assert.ok(Object.values(KITCHEN_CAPABILITIES).some(list => list.includes(capability)), `${theme.id}: nonexistent kitchen capability`);
+    for (const id of theme.recipeIds) {
+      const recipe = recipes.get(id);
+      assert.ok(recipe, `${theme.id}: unknown recipe ${id}`);
+      assert.ok(recipe.level <= theme.level, `${theme.id}: recipe unlocks after the evening`);
+      for (const need of recipe.equipment) {
+        assert.ok(grants.has(need), `${theme.id}: starter suggestions lack ${need} for ${id}`);
+        assert.ok(theme.prerequisites.kitchenCapabilities.includes(need), `${theme.id}: recipe need omitted from capability gate`);
+      }
+      if (recipe.homeOnly) assert.ok(theme.prerequisites.houseLevel >= 2, `${theme.id}: home-only recipe requires the kitchen room`);
+    }
+    for (const goal of theme.goals.options) for (const id of goal.conditions.recipeIds ?? []) {
+      assert.ok(theme.recipeIds.includes(id), `${theme.id}: goal advertises an unstaged menu item`);
+    }
+  }
+});
+
+test('event prerequisites do not require a higher future patch level or attraction tier', () => {
+  for (const theme of content.themes) {
+    const p = theme.prerequisites;
+    assert.ok(UNLOCKS.house[p.houseLevel - 1] <= theme.level, `${theme.id}: future house gate`);
+    for (const id of p.visitorEventIds) {
+      assert.ok(events.has(id), `${theme.id}: nonexistent guest event`);
+      assert.ok(events.get(id).level <= theme.level, `${theme.id}: future guest event`);
+    }
+    if (p.cocoaTier) assert.ok(COCOA_TIERS[p.cocoaTier - 1]?.level <= theme.level, `${theme.id}: future cocoa gate`);
+    for (const attraction of p.attractions) {
+      const maze = attraction.id === 'hollow-house';
+      assert.ok(maze || attraction.id === 'hayride', `${theme.id}: unknown attraction`);
+      const property = maze ? HOLLOW_PROPERTY : HAYRIDE_PROPERTY;
+      const tier = (maze ? FOYER_TIERS : HAYRIDE_TIERS)[attraction.minTier - 1];
+      assert.ok(property.level <= theme.level && tier?.patchLevel <= theme.level, `${theme.id}: future attraction gate`);
+      for (const route of HAYRIDE_ROUTE_UPGRADES.slice(0, attraction.routeLevel ?? 0)) {
+        assert.ok(route.patchLevel <= theme.level && route.tier <= attraction.minTier, `${theme.id}: inaccessible route extension`);
+      }
+    }
+  }
+});
+
+test('every proposed goal has explicit counting, units and an attainable referenced product', () => {
+  for (const theme of content.themes) {
+    assert.equal(theme.goals.choose, 3);
+    assert.equal(theme.goals.options.length, 4);
+    assert.equal(theme.goals.tuningStatus, 'suggested-unbalanced');
+    assert.equal(new Set(theme.goals.options.map(g => g.id)).size, 4);
+    assert.equal(new Set(theme.goals.options.map(g => g.metricId)).size, 4, `${theme.id}: avoid counting the same behaviour as multiple alternatives`);
+    for (const goal of theme.goals.options) {
+      const metric = content.metricDefinitions[goal.metricId];
+      assert.ok(metric?.adapterRequirement && metric?.aggregation, `${theme.id}: undefined authoritative metric ${goal.metricId}`);
+      assert.equal(goal.unit, metric.unit);
+      assert.ok(Number.isSafeInteger(goal.target) && goal.target > 0);
+      assert.ok(['session', 'preparation-or-session'].includes(goal.window));
+      for (const id of goal.conditions.cocoaProductIds ?? []) {
+        if (id === 'cocoa') continue;
+        assert.ok(specials.has(id), `${theme.id}: nonexistent cocoa special`);
+        assert.ok(specials.get(id).tier <= theme.prerequisites.cocoaTier, `${theme.id}: unprepared cocoa tier`);
+      }
+      for (const id of goal.conditions.attractionIds ?? []) {
+        assert.ok(theme.prerequisites.attractions.some(a => a.id === id), `${theme.id}: goal requires an unprepared attraction`);
+      }
+      if (goal.conditions.minimumRouteLevel) {
+        assert.ok(theme.prerequisites.attractions.some(a => a.id === 'hayride' && a.routeLevel >= goal.conditions.minimumRouteLevel));
+      }
+      if (goal.conditions.minimumHappiness !== undefined) assert.ok(goal.conditions.minimumHappiness >= 0 && goal.conditions.minimumHappiness <= 100);
+      if (goal.conditions.maximumQueueSeconds !== undefined) assert.ok(goal.conditions.maximumQueueSeconds > 0);
+    }
+  }
+});
+
+test('garden alternatives use real productive pieces and remain optional', () => {
+  for (const theme of content.themes) {
+    const gardenGoals = theme.goals.options.filter(g => g.metricId === 'garden-harvest-quantity');
+    assert.ok(theme.goals.options.length - gardenGoals.length >= theme.goals.choose, `${theme.id}: players must be able to choose three goals without garden work`);
+    for (const id of [...theme.prerequisites.gardenDecorIds, ...(theme.recommendedGardenDecorIds ?? [])]) {
+      assert.ok(garden.get(id)?.crop, `${theme.id}: nonproductive garden recommendation`);
+      assert.ok(garden.get(id).houseLevel <= theme.prerequisites.houseLevel);
+    }
+    for (const goal of gardenGoals) for (const id of goal.conditions.gardenDecorIds) {
+      const crop = garden.get(id)?.crop;
+      assert.ok(crop, `${theme.id}: unknown harvest crop`);
+      assert.ok(theme.recipeIds.some(recipe => Object.hasOwn(recipes.get(recipe).ingredients, crop.yields)), `${theme.id}: the garden crop has no connection to tonight's menu`);
+    }
+  }
+});
+
+test('preparation and operation cannot punish absence or force an active-play style', () => {
+  assert.equal(content.policy.preparation, 'untimed');
+  for (const theme of content.themes) {
+    assert.equal(theme.preparation.length, 3);
+    assert.equal(theme.operation.mode, 'player-ended');
+    assert.equal(theme.operation.hardDeadline, false);
+    assert.equal(theme.operation.offlineSimulation, false);
+    assert.equal(theme.operation.pauseWithGame, true);
+    assert.equal(theme.operation.failurePenalty, 'none');
+    assert.ok(theme.operation.suggestedMinutes > 0);
+    assert.ok(!theme.goals.options.some(goal => /thumbstick|controller|walked|manual/i.test(goal.metricId)), `${theme.id}: optional goals must accept automated service`);
+  }
+});

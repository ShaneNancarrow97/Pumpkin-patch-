+{
+  "version": 1,
+  "scope": "Controlled ride capacity study — not whole-farm profit or a player-time forecast",
+  "options": {
+    "durationSeconds": 1800,
+    "stepSeconds": 1,
+    "arrivalEverySeconds": 30,
+    "partySize": 4,
+    "guestBudget": 60,
+    "acceptance": "walk-in"

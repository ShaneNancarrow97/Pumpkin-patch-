+.piece-name .thumb { width: 36px; height: 40px; flex: 0 0 36px; }
+.piece-name .thumb img { width: 36px; height: 36px; }
+.tool-done { min-width: 60px; min-height: 44px; padding: 0 12px; border-radius: 12px; }
+.piece-actions { width: 100%; display: flex; align-items: center; flex-wrap: nowrap; justify-content: space-between; gap: 4px; border-top: 1px solid var(--house-edge); padding-top: 5px; }
+.tool-move { min-width: 66px !important; padding: 0 12px; border-color: transparent; background: #ffffff08; }
+.tool-icon { font-size: 24px; color: var(--ink-soft); }

+@media (max-width: 520px) { .place-back-text { display: none; } #place-back { padding-right: 6px; } .place-bar h2 { font-size: 18px; } }
+.piece-bar { position: fixed; z-index: 28; left: calc(var(--rail-w) + 8px); right: 8px; bottom: calc(var(--dock-h) + 8px); max-width: 620px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; padding: 8px; border: 1px solid var(--brass); border-radius: 18px; background: var(--panel-glass); box-shadow: var(--shadow); backdrop-filter: blur(6px); }
+.piece-name { display: flex; align-items: center; gap: 8px; min-width: 0; }
+.piece-name .thumb { width: 44px; height: 44px; }
+.piece-name b { display: block; font: 600 16px var(--display); }
+.piece-name small { color: var(--ink-soft); font-size: 12px; }
+.piece-actions { display: flex; flex-wrap: wrap; gap: 6px; }
+.piece-actions .button { min-width: 0; }
+@media (orientation: landscape) and (min-width: 600px), (min-width: 900px) {
+  .piece-bar { right: calc(min(440px, 100% - var(--rail-w) - 16px) + 16px); }
+  .dialogue { right: calc(min(440px, 100% - var(--rail-w) - 16px) + 16px); bottom: 70px; }
+}
+
+/* Menu pieces */
+.chips { display: flex; flex-wrap: wrap; gap: 6px; }
+.chip { min-height: 44px; display: inline-flex; align-items: center; gap: 6px; padding: 0 12px; border: 1px solid var(--edge-soft); border-radius: 999px; background: rgba(0, 0, 0, .2); color: var(--ink-soft); font-weight: 600; font-size: 13px; }
+.chip[aria-pressed="true"] { border-color: var(--gold); background: linear-gradient(160deg, #7a5233, #4d3036); color: var(--gold-bright); }
+.chip:disabled { opacity: .45; }
+.chip small { font-size: 12px; color: var(--ink-soft); }
+.dot { width: 14px; height: 14px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .3); }
+.plot-card .chips { justify-content: center; }
+.plot-card.locked { opacity: .7; }
+.card.current { border-color: var(--gold); }
+.card.hero { grid-template-columns: 56px minmax(0, 1fr); }
+.card.waiting { opacity: .75; }
+.card .stack { display: flex; flex-direction: column; gap: 6px; }
+.small-eyebrow { font-size: 12px; letter-spacing: .06em; }

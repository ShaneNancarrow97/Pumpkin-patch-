+.close { font-size: 26px; border: 1px solid var(--edge-soft); }
+.sheet-body { overflow-y: auto; overscroll-behavior: contain; padding: 12px 2px 4px; display: flex; flex-direction: column; gap: 10px; }
+.sheet-body p { margin: 0; color: var(--ink-soft); }
+.segmented { display: flex; gap: 6px; padding: 4px; border: 1px solid var(--edge-soft); border-radius: 14px; background: rgba(0, 0, 0, .2); }
+.segmented button { flex: 1; min-height: 44px; border: 0; border-radius: 10px; background: transparent; color: var(--ink-soft); font-weight: 600; }
+.segmented button[aria-pressed="true"] { background: linear-gradient(160deg, #7a5233, #4d3036); color: var(--gold-bright); box-shadow: inset 0 1px rgba(255, 230, 170, .25); }
+.card { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px 12px; border: 1px solid var(--edge-soft); border-radius: 14px; background: linear-gradient(150deg, rgba(74, 51, 56, .55), rgba(40, 29, 44, .7)); }
+.card.done { opacity: .72; }
+.card h3 { margin: 0 0 2px; font: 600 17px/1.2 var(--display); }
+.card p { font-size: 13px; }
+.thumb { width: 56px; height: 56px; border-radius: 12px; background: radial-gradient(circle at 50% 60%, rgba(255, 180, 90, .25), transparent 70%); display: grid; place-items: center; }
+.thumb img { width: 52px; height: 52px; image-rendering: auto; }
+.pips { display: flex; gap: 4px; margin-top: 6px; }
+.pips i { width: 14px; height: 6px; border-radius: 3px; background: #3c2d3a; }
+.pips i.on { background: linear-gradient(90deg, #8aa66a, #d0b96b); }
+.button { min-height: 44px; min-width: 76px; padding: 0 14px; border: 1px solid var(--edge); border-radius: 12px; background: var(--raised); font-weight: 600; white-space: nowrap; }
+.button:disabled { opacity: .6; cursor: default; }
+.button small { display: block; font-size: 12px; font-weight: 400; color: var(--ink-soft); }
+.plot-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
+.plot-card { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 10px; border: 1px solid var(--edge-soft); border-radius: 14px; background: rgba(40, 29, 44, .7); text-align: center; }
+.plot-card h3 { margin: 0; font: 600 15px var(--display); }
+.who { display: flex; align-items: center; gap: 10px; margin-top: 4px; }
+.who h3 { margin: 0; font: 600 20px var(--display); }
+.swatch { width: 44px; height: 44px; border-radius: 12px; border: 2px solid rgba(255, 255, 255, .15); box-shadow: inset 0 -6px 0 rgba(0, 0, 0, .25); }
+.bar { height: 8px; border-radius: 4px; background: #3c2d3a; overflow: hidden; margin-top: 6px; }
+.bar i { display: block; height: 100%; background: linear-gradient(90deg, #8aa66a, #d0b96b); }
+.setting { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 4px; border-bottom: 1px solid var(--edge-soft); }
+.setting span small { display: block; color: var(--ink-soft); font-size: 12px; }
+.danger { border-color: var(--ember); color: #ffc0a8; }
+.about { font-size: 13px; color: var(--ink-soft); }
+
+/* ---- Features from the main game ---- */
+.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+.small { font-size: 12px !important; color: var(--ink-soft); }
+.section { margin: 8px 2px 0; font: 600 16px var(--display); color: var(--gold-bright); }
+.wide { width: 100%; }
+.error { color: #ffb4a0 !important; }
+
+/* The HUD's level meter: a thin brass line along its foot. */
+.hud { position: fixed; }
+.hud-level { position: absolute; left: 14px; right: 54px; bottom: 5px; height: 3px; }
+.hud-level i { position: absolute; inset: 0; border-radius: 2px; background: rgba(0, 0, 0, .35); overflow: hidden; }
+.hud-level b { display: block; height: 100%; background: linear-gradient(90deg, #8aa66a, var(--gold-bright)); }
+
+/* Streak pill, tea break, dialogue */
+.streak, .paused { position: fixed; z-index: 15; top: calc(var(--top) + 116px); left: calc(var(--rail-w) + 8px); padding: 6px 12px; border: 1px solid var(--gold); border-radius: 999px; background: var(--panel-glass); color: var(--gold-bright); font: 600 13px var(--body); box-shadow: var(--shadow); }

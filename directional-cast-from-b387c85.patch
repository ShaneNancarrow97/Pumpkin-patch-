+const cells = new Map(HAYRIDE_ICON_IDS.map((id, index) => [id, Object.freeze({
+  index,
+  column: index % HAYRIDE_ICON_GRID.columns,
+  row: Math.floor(index / HAYRIDE_ICON_GRID.columns),
+})]));
+export const hayrideIconCell = id => cells.get(id) ?? null;

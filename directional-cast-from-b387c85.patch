+/* The workshop adds depth without widening or covering the playfield. */
+.cooking-tabs { max-width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; scrollbar-width: thin; scrollbar-color: #9b7a5059 transparent; scroll-padding-inline: 6px; }

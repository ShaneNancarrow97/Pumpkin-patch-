+.wall-tool[aria-pressed="true"] { background: #e7b46e19; color: var(--gold-bright); }
+.nudge-tools { width: 100%; display: flex; justify-content: center; border-top: 1px solid var(--house-edge); }
+.piece-more { position: absolute; bottom: calc(100% + 8px); right: 0; width: 225px; padding: 8px; display: flex; flex-direction: column; gap: 5px; max-height: min(45dvh, 320px); overflow: auto; overscroll-behavior: contain; border: 1px solid var(--house-edge); background: var(--house-glass); border-radius: 16px; box-shadow: var(--shadow); }

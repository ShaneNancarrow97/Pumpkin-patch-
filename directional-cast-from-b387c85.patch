+<title>Pumpkin Patch · Voxel</title>
+<style>/* Voxel reference build. Tokens follow docs/GAME-BIBLE.md §4: plum night,
+   brass edges, candle-warm text, one gold button per view. */
+@font-face { font-family: 'Fraunces'; src: url('data:font/woff2;base64,') format('woff2'); font-weight: 400; font-display: swap; }
+@font-face { font-family: 'Fraunces'; src: url('data:font/woff2;base64,') format('woff2'); font-weight: 600; font-display: swap; }
+@font-face { font-family: 'DM Sans'; src: url('data:font/woff;base64,') format('woff'); font-weight: 400 700; font-display: swap; }
+
+:root {
+  --ground: #130f1b;
+  --panel: #231a28;
+  --panel-glass: rgba(31, 22, 36, 0.9);
+  --raised: #34263a;
+  --edge: #8a6249;
+  --edge-soft: #4e3a46;
+  --brass: #c9975a;
+  --ink: #fbe7c6;
+  --ink-soft: #d8c2ad;
+  --gold: #e7b46e;
+  --gold-bright: #ffd894;
+  --pumpkin: #e8862e;
+  --purchase-top: #ffd07c;
+  --purchase-bottom: #ed983f;
+  --purchase-ink: #301b0e;
+  --moss: #9db382;
+  --ember: #e07a55;
+  --display: 'Fraunces', Georgia, serif;
+  --body: 'DM Sans', system-ui, sans-serif;
+  --shadow: 0 6px 22px rgba(6, 3, 12, 0.5);
+  --dock-h: calc(66px + env(safe-area-inset-bottom));
+  --rail-w: 0px;
+  --top: calc(env(safe-area-inset-top) + 8px);
+  color-scheme: dark;
+}
+* { box-sizing: border-box; }
+[hidden] { display: none !important; }
+html, body { height: 100%; margin: 0; overflow: hidden; background: var(--ground); color: var(--ink); font: 14px/1.4 var(--body); -webkit-tap-highlight-color: transparent; }
+button { font: inherit; color: inherit; cursor: pointer; }
+button:focus-visible { outline: 3px solid var(--gold-bright); outline-offset: 2px; }
+#world { position: fixed; inset: 0 0 var(--dock-h) var(--rail-w); width: calc(100% - var(--rail-w)); height: calc(100% - var(--dock-h)); display: block; touch-action: none; }
+#fx { position: fixed; inset: 0 0 var(--dock-h) var(--rail-w); pointer-events: none; z-index: 5; }
+
+/* HUD */
+.hud { position: fixed; z-index: 20; top: var(--top); left: calc(var(--rail-w) + (100% - var(--rail-w)) / 2); transform: translateX(-50%);
+  width: min(520px, calc(100% - var(--rail-w) - 16px)); height: 56px; display: flex; align-items: center; gap: 4px; padding: 4px 4px 4px 10px;
+  background: var(--panel-glass); border: 1px solid var(--edge); border-radius: 18px; box-shadow: var(--shadow); backdrop-filter: blur(6px); }
+.hud-stats { flex: 1; display: flex; min-width: 0; }
+.hud-stat { flex: 1; display: flex; align-items: center; gap: 8px; min-width: 0; padding: 0 8px; }
+.hud-stat:first-child { flex: 1.4; }
+.hud-stat + .hud-stat { border-left: 1px solid var(--edge-soft); }
+.hud-stat small { display: block; color: var(--ink-soft); font: 600 12px/1.1 var(--body); letter-spacing: 0.06em; text-transform: uppercase; }
+.hud-stat strong { display: block; font: 600 20px/1.15 var(--display); font-variant-numeric: tabular-nums; white-space: nowrap; }
+.icon-button { width: 44px; height: 44px; flex-shrink: 0; display: grid; place-items: center; border: 0; border-radius: 12px; background: transparent; }
+.icon-button:hover { background: var(--raised); }
+
+/* Icons: the main game's own (assets/ui), baked as voxel tiles into
+   icons.png by tools/bake_sprites.py. The old class names map onto them. */
+.coin-icon, .crate-icon, .ghost-icon, .gear-icon, .seed-icon, .spark-icon, .basket-icon, .tab-icon {
+  --s: 36px; display: inline-block; flex-shrink: 0; width: var(--s); height: var(--s); background: url('data:image/png;base64,') no-repeat;
+  background-size: calc(var(--s) * 24) var(--s); background-position: calc(var(--i) * var(--s) * -1) 0; image-rendering: pixelated; }
+.coin-icon { --i: 5; } .crate-icon { --i: 6; } .ghost-icon { --i: 7; } .gear-icon { --i: 18; } .seed-icon { --i: 13; } .spark-icon { --i: 16; } .basket-icon { --i: 23; }
+.tab-icon.patch { --i: 0; } .tab-icon.home { --i: 1; } .tab-icon.wardrobe { --i: 2; } .tab-icon.journal { --i: 4; } .tab-icon.shop { --i: 14; }
+.action .ico, .action [class$="-icon"] { --s: 36px; margin: -6px 0; }
+.thumb .ico, .thumb [class$="-icon"] { --s: 54px; }

@@ -0,0 +1,169 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { DIRECTION_DEGREES, DIRECTIONAL_ACTIONS, LOCOMOTION_PHASES, PUSH_PHASES, REDUCED_LOCOMOTION_PHASES, REDUCED_PUSH_PHASES, directionalBin, directionFromView, createDirectionalManifest, validateDirectionalManifest, directionalCoverage, selectDirectionalFrame, directionalAtlasBudget, compileDirectionalManifest } from '../src/content/directional-atlas.js';
+
+function fixture(action = 'walk', degree = 0, mobility = 'walking') {
+  const m = createDirectionalManifest({ look: 'natalie-base', owner: 'natalie', mobility, sourceSeed: 'approved/natalie-front.png' });
+  m.pages.push({ id: 'a', url: 'assets/cast/natalie-base/walk-000.webp', width: 2048, height: 320 });
+  m.clips.push({ action, degree, authoring: 'drawn', review: { approved: true, preview: 'review/natalie-walk.gif' }, frames: Array.from({ length: DIRECTIONAL_ACTIONS[action].frames }, (_, i) => ({ page: 'a', rect: { x: i * 256, y: 0, w: 256, h: 320 }, anchor: { x: 128, y: 310 }, pixelsPerUnit: m.pixelsPerUnit, fingerprint: `${action}-${degree}-pixels-${i}`, phase: (mobility === 'wheelchair' ? PUSH_PHASES : LOCOMOTION_PHASES)[i] })) });
+  return m;
+}
+
+test('24 camera-relative bins wrap across north without inventing a view for NaN', () => {
+  assert.equal(DIRECTION_DEGREES.length, 24); assert.deepEqual(DIRECTION_DEGREES.slice(-2), [330, 345]);
+  for (const [angle, expected] of [[0, 0], [360, 0], [-15, 345], [7.49, 0], [7.5, 15], [359, 0], [735, 15]]) assert.equal(directionalBin(angle), expected);
+  assert.equal(directionalBin(NaN), null); assert.equal(directionalBin(Infinity), null);
+});
+
+test('an empty production manifest honestly reports every action and angle missing', () => {
+  const m = createDirectionalManifest({ look: 'shane-base', owner: 'shane', sourceSeed: 'approved/shane.png' });
+  assert.equal(validateDirectionalManifest(m).ok, true);
+  const c = directionalCoverage(m); assert.equal(c.complete, false); assert.equal(c.expectedClips, 312); assert.equal(c.expectedFrames, 1920); assert.equal(c.authoredFrames, 0); assert.equal(c.missing.length, 312);
+  assert.equal(selectDirectionalFrame(m).coverage, 'missing');
+});
+
+test('approved eight-phase art selects both contact legs and a once-only action endpoint', () => {
+  const m = fixture(); assert.deepEqual(validateDirectionalManifest(m).warnings, []);
+  assert.equal(selectDirectionalFrame(m, { action: 'walk', yaw: 0, progress: 0 }).frame.phase, 'contact-left');
+  assert.equal(selectDirectionalFrame(m, { action: 'walk', yaw: 0, progress: .5 }).frame.phase, 'contact-right');
+  assert.equal(selectDirectionalFrame(m, { action: 'walk', yaw: 360, progress: 1 }).index, 0);
+  const p = fixture('plant'); assert.equal(selectDirectionalFrame(p, { action: 'plant', progress: 1 }).index, 5);
+  assert.equal(directionalCoverage(m, ['walk']).authoredFrames, 8);
+});
+
+test('a nearest view is an explicit opt-in fallback and cannot fill coverage or change action', () => {
+  const m = fixture(); assert.equal(selectDirectionalFrame(m, { action: 'walk', yaw: 15 }).frame, null);
+  const f = selectDirectionalFrame(m, { action: 'walk', yaw: 15, allowNearest: true });
+  assert.equal(f.coverage, 'fallback'); assert.equal(f.direction, 0); assert.equal(f.requestedDegree, 15);
+  assert.equal(selectDirectionalFrame(m, { action: 'water', allowNearest: true }).coverage, 'missing');
+  const c = directionalCoverage(m, ['walk']); assert.equal(c.authoredClips, 1); assert.equal(c.missing.length, 23);
+});
+
+test('repeated frames, copied angle sequences and mirrored art cannot claim new coverage', () => {
+  const repeated = fixture(); repeated.clips[0].frames[4].fingerprint = repeated.clips[0].frames[0].fingerprint;
+  assert.equal(directionalCoverage(repeated, ['walk']).authoredFrames, 0);
+  const copy = fixture(); copy.clips.push({ ...structuredClone(copy.clips[0]), degree: 15 });
+  assert.equal(directionalCoverage(copy, ['walk']).authoredClips, 1); assert.equal(selectDirectionalFrame(copy, { action: 'walk', yaw: 15 }).coverage, 'missing');
+  for (const authoring of ['mirrored', 'plane-rotation', 'held-duplicate']) { const m = fixture(); m.clips[0].authoring = authoring; assert.equal(directionalCoverage(m).authoredFrames, 0); }
+});
+
+test('missing review, clipped frames, drifting scale and impossible anchors block a clip', () => {
+  for (const alter of [m => { m.clips[0].review.approved = false; }, m => { m.clips[0].frames[7].rect.x = 2040; }, m => { m.clips[0].frames[2].pixelsPerUnit *= 1.1; }, m => { m.clips[0].frames[3].anchor.y = 500; }]) {
+    const m = fixture(); alter(m); assert.equal(directionalCoverage(m, ['walk']).authoredClips, 0); assert.ok(validateDirectionalManifest(m).warnings.length);
+  }
+});
+
+test('wheelchair locomotion requires arm/rim-push phases instead of walking leg claims', () => {
+  const m = fixture('walk', 0, 'wheelchair'); assert.equal(directionalCoverage(m, ['walk']).authoredFrames, 8);
+  assert.equal(selectDirectionalFrame(m, { action: 'walk', progress: .25 }).frame.phase, 'push-start');
+  m.clips[0].frames[0].phase = 'contact-left'; assert.equal(directionalCoverage(m, ['walk']).authoredFrames, 0);
+});
+
+test('malformed or duplicated manifests cannot choose ambiguous runtime art', () => {
+  assert.equal(validateDirectionalManifest(null).ok, false); assert.equal(selectDirectionalFrame(null).frame, null);
+  const m = fixture(); m.clips.push(structuredClone(m.clips[0])); assert.equal(validateDirectionalManifest(m).ok, false); assert.equal(selectDirectionalFrame(m, { action: 'walk' }).frame, null);
+  const n = fixture(); n.pages.push({ ...n.pages[0] }); assert.equal(validateDirectionalManifest(n).ok, false);
+});
+
+test('memory budgets distinguish decoded textures, mipmaps, measured encoding and HTML expansion', () => {
+  const b = directionalAtlasBudget(); assert.equal(b.frames, 3840); assert.equal(b.rgbaBytes, 1258291200); assert.equal(b.rgbaMipBytes, 1677721600); assert.equal(b.encodedBytes, null);
+  const one = directionalAtlasBudget({ looks: 1, directions: 4, encodedBytesPerFrame: 5000 }); assert.equal(one.rgbaBytes, 10485760); assert.equal(one.encodedBytes, 160000); assert.equal(one.base64Bytes, 213336);
+  assert.throws(() => directionalAtlasBudget({ width: -1 }), RangeError);
+});
+
+test('single authored neutral poses are usable without claiming a complete breathing animation', () => {
+  const m=fixture('idle',90);m.clips[0].mode='pose';m.clips[0].frames=m.clips[0].frames.slice(0,1);
+  const f=selectDirectionalFrame(m,{action:'idle',yaw:90,progress:.8});assert.ok(f.frame);assert.equal(f.mode,'pose');assert.equal(f.direction,90);
+  const c=directionalCoverage(m,['idle']);assert.equal(c.authoredPoses,1);assert.equal(c.authoredClips,0);assert.equal(c.authoredFrames,1);assert.equal(c.complete,false);
+  for(const [x,z,want]of [[0,-1,0],[1,0,90],[0,1,180],[-1,0,270]])assert.equal(directionFromView(x,z),want);
+  assert.equal(directionFromView(0,0),null);
+});
+
+test('compiled selection matches direct selection without re-reading source metadata per frame', () => {
+  const m=fixture(), clips=m.clips;let sealed=false;
+  Object.defineProperty(m,'clips',{get(){if(sealed)throw Error('source was re-read');return clips;}});
+  const compiled=compileDirectionalManifest(m);
+  const expected=[];for(const yaw of [0,15,90,345,NaN])for(const progress of [-.25,0,.5,1])expected.push({args:{action:'walk',yaw,progress,allowNearest:true},value:selectDirectionalFrame(m,{action:'walk',yaw,progress,allowNearest:true})});
+  sealed=true;for(const {args,value}of expected)assert.deepEqual(JSON.parse(JSON.stringify(compiled.select(args))),JSON.parse(JSON.stringify(value)));
+  assert.equal(compiled.look,'natalie-base');assert.equal(compiled.pageMap.a.width,2048);
+});
+
+test('compiled metadata is a deep frozen snapshot and admits no later source changes', () => {
+  const m=fixture(), compiled=compileDirectionalManifest(m);
+  m.pages[0].url='changed.webp';m.clips[0].review.approved=false;m.clips[0].frames[0].rect.w=50000;
+  const extra=fixture('walk',15).clips[0];m.clips.push(extra);
+  assert.equal(compiled.select({action:'walk',yaw:0}).frame.rect.w,256);
+  assert.equal(compiled.select({action:'walk',yaw:15}).coverage,'missing');
+  assert.equal(compiled.pageMap.a.url,'assets/cast/natalie-base/walk-000.webp');
+  assert.throws(()=>{compiled.actions.walk.directions[0].frames[0].anchor.x=10;},TypeError);
+  assert.throws(()=>{compiled.pageMap.a.url='no.webp';},TypeError);
+  assert.equal(compileDirectionalManifest(null).select({action:'walk'}).coverage,'missing');
+});
+
+function reducedFixture(action = 'walk', degree = 90, mobility = 'walking') {
+  const m = fixture(action, degree, mobility), c = m.clips[0];
+  c.mode = 'reduced'; c.frames = [0, 2, 4, 6].map(i => c.frames[i]);
+  return m;
+}
+
+test('a reviewed four-phase cycle exposes both contact legs without claiming full eight-phase coverage', () => {
+  assert.deepEqual(REDUCED_LOCOMOTION_PHASES, ['contact-left', 'passing-left', 'contact-right', 'passing-right']);
+  for (const action of ['walk', 'jog']) {
+    const m = reducedFixture(action), compiled = compileDirectionalManifest(m);
+    assert.deepEqual(validateDirectionalManifest(m).warnings, []);
+    for (let i = 0; i < 4; i++) {
+      const args = { action, yaw: 90, progress: i / 4 };
+      const selected = compiled.select(args);
+      assert.equal(selected.mode, 'reduced'); assert.equal(selected.frameCount, 4);
+      assert.equal(selected.index, i); assert.equal(selected.frame.phase, REDUCED_LOCOMOTION_PHASES[i]);
+      assert.deepEqual(JSON.parse(JSON.stringify(selected)), JSON.parse(JSON.stringify(selectDirectionalFrame(m, args))));
+    }
+    assert.equal(compiled.select({ action, yaw: 90, progress: 1 }).index, 0);
+    assert.equal(compiled.select({ action, yaw: 75, allowNearest: true }).coverage, 'fallback');
+    const c = directionalCoverage(m, [action]);
+    assert.equal(c.authoredClips, 0); assert.equal(c.authoredReducedCycles, 1);
+    assert.equal(c.authoredReducedFrames, 4); assert.equal(c.authoredFrames, 4);
+    assert.equal(c.complete, false); assert.equal(c.missing.length, 24);
+    assert.ok(c.missing.some(x => x.action === action && x.degree === 90));
+    assert.equal(compiled.coverage.authoredReducedCycles, 1);
+  }
+});
+
+test('reduced cycles reject the first four full-gait phases, padding, duplicate pixels and non-locomotion shortcuts', () => {
+  for (const alter of [
+    m => { m.clips[0].frames = fixture().clips[0].frames.slice(0, 4); },
+    m => { m.clips[0].frames.push(...structuredClone(m.clips[0].frames)); },
+    m => { m.clips[0].frames[2].fingerprint = m.clips[0].frames[0].fingerprint; },
+    m => { delete m.clips[0].mode; },
+    m => { m.clips[0].action = 'water'; },
+    m => { m.clips[0].mode = 'nearly-eight'; },
+  ]) {
+    const m = reducedFixture(); alter(m);
+    assert.equal(directionalCoverage(m).authoredFrames, 0);
+    assert.equal(compileDirectionalManifest(m).select({ action: m.clips[0].action, yaw: 90 }).frame, null);
+    assert.ok(validateDirectionalManifest(m).warnings.length);
+  }
+});
+
+test('reduced wheelchair cycles use reviewed alternating push/recovery states instead of leg contacts', () => {
+  assert.deepEqual(REDUCED_PUSH_PHASES, ['reach', 'push-start', 'release', 'recover-high']);
+  const m = reducedFixture('walk', 180, 'wheelchair'), args = { action: 'walk', yaw: 180, progress: .5 };
+  assert.equal(selectDirectionalFrame(m, args).frame.phase, 'release');
+  assert.equal(selectDirectionalFrame(m, args).frameCount, 4);
+  assert.equal(directionalCoverage(m, ['walk']).authoredReducedCycles, 1);
+  m.clips[0].frames[0].phase = 'contact-left';
+  assert.equal(directionalCoverage(m, ['walk']).authoredReducedCycles, 0);
+});
+
+test('mixed full, reduced and neutral-pose coverage keeps total frame counts and missing cells honest', () => {
+  const m = fixture('walk', 0);
+  m.clips.push(reducedFixture('walk', 90).clips[0]);
+  const pose = fixture('idle', 180).clips[0]; pose.mode = 'pose'; pose.frames = pose.frames.slice(0, 1); m.clips.push(pose);
+  const c = directionalCoverage(m, ['walk', 'idle']);
+  assert.equal(c.expectedFrames, 288); assert.equal(c.authoredClips, 1);
+  assert.equal(c.authoredReducedCycles, 1); assert.equal(c.authoredPoses, 1); assert.equal(c.authoredFrames, 13);
+  assert.equal(c.missing.length, 47);
+  assert.equal(selectDirectionalFrame(m, { action: 'walk', yaw: 0 }).frameCount, 8);
+  assert.equal(selectDirectionalFrame(m, { action: 'idle', yaw: 180 }).frameCount, 1);
+  assert.equal(selectDirectionalFrame(m, { action: 'water' }).frameCount, 0);
+});
diff --git a/voxel/test/hayride-icons.test.mjs b/voxel/test/hayride-icons.test.mjs
new file mode 100644
index 0000000..ae17749
--- /dev/null
+++ b/voxel/test/hayride-icons.test.mjs
@@ -0,0 +1,53 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { HAYRIDE_TIERS, HAYRIDE_OPERATIONS, HAYRIDE_ROUTE_UPGRADES, HAYRIDE_SCARES } from '../src/content/hayride.js';
+import { HAYRIDE_ICON_GRID, HAYRIDE_ICON_IDS, hayrideIconCell } from '../src/content/hayride-icon-map.js';
+
+test('every actual tractor ride purchase has its own known art cell', () => {
+  const purchases = [
+    ...HAYRIDE_TIERS.map(t => 'tier' + t.level),
+    ...HAYRIDE_OPERATIONS.map(u => u.id),
+    ...HAYRIDE_ROUTE_UPGRADES.map(u => 'route' + u.level),
+    ...HAYRIDE_SCARES.map(u => u.id),
+  ];
+  assert.deepEqual([...purchases].sort(), [...HAYRIDE_ICON_IDS].sort(), 'catalogue changed: provide or retire the corresponding upgrade art');
+  assert.equal(new Set(HAYRIDE_ICON_IDS).size, HAYRIDE_ICON_IDS.length);
+  for (const id of purchases) {
+    const cell = hayrideIconCell(id);
+    assert.ok(cell, id);
+    assert.ok(cell.column >= 0 && cell.column < HAYRIDE_ICON_GRID.columns, id);
+    assert.ok(cell.row >= 0 && cell.row < HAYRIDE_ICON_GRID.rows, id);
+  }
+  for (const unknown of ['not-an-upgrade', '', undefined, null, '__proto__']) assert.equal(hayrideIconCell(unknown), null);
+});
+
+function webpDimensions(bytes) {
+  assert.equal(bytes.toString('ascii', 0, 4), 'RIFF');
+  assert.equal(bytes.toString('ascii', 8, 12), 'WEBP');
+  assert.equal(bytes.readUInt32LE(4) + 8, bytes.length, 'complete RIFF file');
+  for (let p = 12; p + 8 <= bytes.length;) {
+    const type = bytes.toString('ascii', p, p + 4), n = bytes.readUInt32LE(p + 4), start = p + 8;
+    assert.ok(start + n <= bytes.length, 'complete WebP chunk');
+    if (type === 'VP8X') return { width: 1 + bytes.readUIntLE(start + 4, 3), height: 1 + bytes.readUIntLE(start + 7, 3) };
+    if (type === 'VP8L') {
+      assert.equal(bytes[start], 0x2f);
+      const bits = bytes.readUInt32LE(start + 1);
+      return { width: 1 + (bits & 0x3fff), height: 1 + ((bits >>> 14) & 0x3fff) };
+    }
+    if (type === 'VP8 ') {
+      assert.equal(bytes.toString('hex', start + 3, start + 6), '9d012a');
+      return { width: bytes.readUInt16LE(start + 6) & 0x3fff, height: bytes.readUInt16LE(start + 8) & 0x3fff };
+    }
+    p += 8 + n + n % 2;
+  }
+  throw Error('No supported image header');
+}
+
+test('the shipped menu atlas fits the declared cells and a mobile icon budget', () => {
+  const bytes = readFileSync(new URL('../assets/hayride-upgrade-icons.webp', import.meta.url));
+  const { columns, rows, cell } = HAYRIDE_ICON_GRID;
+  assert.deepEqual(webpDimensions(bytes), { width: columns * cell, height: rows * cell });
+  assert.ok(bytes.length < 350 * 1024, 'the icon sheet must not embed a full-size generation');
+  assert.ok(columns * rows * cell * cell * 4 < 2 * 1024 * 1024, 'the menu sheet exceeds 2 MiB decoded');
+});

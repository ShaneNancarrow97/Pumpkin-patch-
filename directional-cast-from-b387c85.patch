+.piece-name { flex: 1; min-width: 0; }
+.piece-name > span:last-child { min-width: 0; }
+.piece-name b { font: 600 14px/1.25 var(--body); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

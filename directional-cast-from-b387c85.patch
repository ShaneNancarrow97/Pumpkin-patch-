+    { level: 14, title: "The warmest room", needs: [requirement("kitchen-oven", "Place an oven and baking tray in the kitchen", 2, (s) => ["oven", "tray"].filter((id) => tools2(s).has(id)).length, "equipment", "kitchen")] },
+    { level: 15, title: "Our haunted haven", needs: [requirement("attic", "Upgrade to the Haunted haven", 3, (s) => s.house?.level ?? 0, "upgrade-house")] },
+    { level: 16, title: "Life in every room", needs: [requirement("three-rooms", "Furnish three different rooms", 3, rooms, "decorate")] },
+    { level: 17, title: "The family kitchen", needs: [requirement("kitchen-kit", "Place a hob, pan, oven, tray and spice station in the kitchen", 5, (s) => ["hob", "pan", "oven", "tray", "spice"].filter((id) => tools2(s).has(id)).length, "equipment", "kitchen")] },

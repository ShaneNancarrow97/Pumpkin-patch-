+.dialogue { position: fixed; z-index: 26; left: calc(var(--rail-w) + 8px); right: 8px; bottom: calc(var(--dock-h) + 66px); max-width: 560px; margin: 0 auto; display: flex; align-items: flex-end; gap: 10px; padding: 10px 14px 10px 8px; border: 1px solid var(--brass); border-radius: 18px; background: linear-gradient(160deg, #3a2840, #241a2a); box-shadow: var(--shadow); text-align: left; animation: rise .25s ease-out; }
+.dialogue-portrait { flex-shrink: 0; width: 64px; height: 76px; overflow: hidden; display: flex; align-items: flex-start; justify-content: center; border-radius: 12px; background: radial-gradient(circle at 50% 30%, rgba(255, 190, 110, .3), transparent 70%); }
+.dialogue-portrait img { flex: none; width: 92px; margin-top: 2px; }
+.dialogue-words { display: flex; flex-direction: column; gap: 3px; }
+.dialogue-name { color: var(--gold); font: 600 13px var(--body); letter-spacing: .08em; text-transform: uppercase; }
+.dialogue-name span { color: var(--ink-soft); font-weight: 400; letter-spacing: 0; text-transform: none; }
+.dialogue-text { font: 16px/1.35 var(--display); }
+.float-text.speech { padding: 4px 9px; border: 1px solid #f0d2a240; border-radius: 10px 10px 10px 3px; background: #241a2bd9; font: 500 13px var(--body); color: var(--ink); }
+
+/* Inside the cottage and the shop */
+.place-bar { position: fixed; z-index: 16; top: calc(var(--top) + 64px); left: calc(var(--rail-w) + 8px); right: 8px; display: flex; align-items: center; gap: 10px; pointer-events: none; }
+.place-bar > * { pointer-events: auto; }

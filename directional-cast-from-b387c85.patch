+.build-pick .pix{filter:drop-shadow(0 3px 3px #2a1e3466)}
+.build-badge{position:absolute;right:5px;top:5px;width:20px;height:20px;border-radius:50%;display:grid;place-items:center;font:700 11px/1 var(--body);font-style:normal;color:#20140c;background:#f5c47c;box-shadow:0 2px 5px #0006}

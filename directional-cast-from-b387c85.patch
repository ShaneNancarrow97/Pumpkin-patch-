+.sheet[data-section="home"]:has(.build-cat){left:max(8px,env(safe-area-inset-left))!important;right:max(8px,env(safe-area-inset-right))!important;top:auto!important;bottom:max(8px,env(safe-area-inset-bottom))!important;width:auto!important;height:min(68dvh,600px);max-height:none!important;padding:0!important;z-index:44}
+body:has(.sheet:not([hidden]) .build-cat) #dock{display:none!important}
+.sheet[data-section="home"]:has(.build-cat) .sheet-frame{padding:10px 12px 10px;border-radius:22px;background:linear-gradient(170deg,#2c2334f8,#18131ef9);box-shadow:inset 0 1px #ffe6c014,0 18px 60px #000b}
+/* The title gives way to the tabs; the close button sits at the end of their row. */
+.sheet[data-section="home"]:has(.build-cat) .sheet-head{position:absolute;top:10px;right:12px;padding:0;border:0;z-index:3}
+.sheet[data-section="home"]:has(.build-cat) .sheet-head>div{display:none}
+.sheet[data-section="home"]:has(.build-cat) #sheet-close{width:42px;height:42px;min-width:42px;min-height:42px}
+.sheet[data-section="home"]:has(.build-cat) .sheet-body{overflow:hidden;padding:2px 0 0;gap:8px;flex:1;min-height:0}
+.sheet[data-section="home"]:has(.build-cat) .segmented{position:relative;top:auto;min-height:38px;margin-right:52px}
+
+.build-cat{flex:1;min-height:0;display:grid;grid-template-columns:62px minmax(0,1fr);grid-template-rows:auto auto minmax(0,1fr) auto auto;grid-template-areas:"top top" "rail subs" "rail grid" "detail detail" "foot foot";gap:8px 10px}

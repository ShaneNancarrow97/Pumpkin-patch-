+@media (orientation: landscape) and (min-width: 600px), (min-width: 900px) {
+  :root { --dock-h: 0px; --rail-w: calc(88px + env(safe-area-inset-left)); }
+  .dock { top: 0; bottom: 0; right: auto; width: var(--rail-w); height: auto; flex-direction: column; justify-content: center; gap: 6px; padding: 8px 6px 8px max(6px, env(safe-area-inset-left)); border-top: 0; border-right: 1px solid var(--edge-soft); }

+  var PUMPKIN_VARIETIES = Object.freeze([
+    ...original,
+    Object.freeze({
+      id: "midnight-moon",
+      name: "Midnight Moon",
+      price: 110,
+      cost: 7800,
+      grow: 48,
+      color: 1516099,
+      glow: 16767093,

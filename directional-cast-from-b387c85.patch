+
+/* The living world comes first. One quiet HUD, one floating navigation dock,
+   and consistent contextual surfaces in every place. */
+:root {
+  --panel: #211e29; --panel-glass: #211e29e8; --raised: #35303c;
+  --edge: #a38b6657; --edge-soft: #bba88c29; --brass: #c5a06f;
+  --ink: #f5ebdb; --ink-soft: #bfb4b1; --gold: #d9ad73; --gold-bright: #f2cf99;
+  --house-glass: #211e29ed; --house-edge: #bba88c29;
+  --shadow: 0 8px 28px #08060d45; --rail-w: 0px;
+  --dock-h: calc(76px + env(safe-area-inset-bottom));
+  --top: calc(8px + env(safe-area-inset-top));
+}
+#world { inset: 0; width: 100%; height: 100%; }
+#fx { inset: 0; }
+button, select, input { touch-action: manipulation; }
+button:focus-visible, summary:focus-visible, select:focus-visible { outline: 2px solid var(--gold-bright); outline-offset: 2px; }
+.hud, .inside-place .hud {
+  top: var(--top); left: 50%; right: auto; transform: translateX(-50%);
+  width: min(388px, calc(100% - 16px - env(safe-area-inset-left) - env(safe-area-inset-right)));
+  min-width: 0; height: 50px; gap: 0; padding: 3px 3px 3px 10px;
+  border: 1px solid var(--edge-soft); border-radius: 16px;
+  background: var(--panel-glass); box-shadow: 0 4px 20px #08060d35; backdrop-filter: blur(12px);
+}
+.hud-stats, .inside-place .hud-stats { flex: 1; gap: 0; }
+.hud-stat, .inside-place .hud-stat:not(:first-child) { display: flex; flex: 0 1 auto; gap: 5px; padding: 0 7px; }
+.hud-stat:first-child { flex: 1 1 auto; padding-left: 0; }
+.hud-stat + .hud-stat { border-left: 0; }
+.hud-stat small, .level-chip small { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+.hud-stat strong, .inside-place .hud-stat strong { font: 600 15px/1.2 var(--body); letter-spacing: -.02em; font-variant-numeric: tabular-nums; }

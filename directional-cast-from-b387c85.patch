+ if(!selected.frame)return false;
+ const gap=Math.abs(((selected.direction-selected.requestedDegree+540)%360)-180);
+ if(gap>45||(kind==='water'&&!selected.frame.sockets?.hand)){d.playerAtlas.coverage='legacy';return false;}

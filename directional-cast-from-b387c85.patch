+.stats div { padding: 10px; border: 1px solid var(--edge-soft); border-radius: 12px; background: rgba(0, 0, 0, .18); }
+.stats b { display: block; font: 600 20px var(--display); color: var(--gold-bright); }
+.stats span { font-size: 12px; color: var(--ink-soft); }

+@media (max-width: 720px) { .inside-place .place-bar { top: calc(var(--top) + 62px); right: 8px; max-width: none; } .room-chip { flex: 1; } .inside-place .hud { left: calc(var(--rail-w) + 8px); width: auto; } }
+.piece-bar { z-index: 28; right: 10px; left: calc(var(--rail-w) + 10px); bottom: calc(var(--dock-h) + 12px); max-width: 410px; padding: 8px 10px; gap: 4px; border: 1px solid var(--house-edge); border-radius: 20px; background: var(--house-glass); box-shadow: 0 12px 36px #08060b66; }

+/* Goal chip and notices under the HUD */
+.goal-chip { position: fixed; z-index: 15; top: calc(var(--top) + 64px); left: calc(var(--rail-w) + 8px); max-width: calc(100% - var(--rail-w) - 16px); min-height: 44px;
+  display: flex; align-items: center; gap: 8px; padding: 8px 14px; border: 1px solid var(--edge-soft); border-radius: 12px; background: var(--panel-glass); font-size: 13px; box-shadow: var(--shadow); }
+.goal-chip.ready { border-color: var(--gold); color: var(--gold-bright); }
+.goal-star { color: var(--gold); }

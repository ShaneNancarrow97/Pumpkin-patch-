+  max-width: min(420px, calc(100% - var(--rail-w) - 32px)); padding: 10px 14px; border: 1px solid var(--edge); border-radius: 12px; background: var(--panel); box-shadow: var(--shadow);
+  opacity: 0; pointer-events: none; transition: opacity .15s, transform .15s; text-align: center; }
+.notice.show { opacity: 1; transform: translate(-50%, 0); }
+.bubble { position: fixed; z-index: 18; max-width: 240px; padding: 10px 12px; border: 1px solid var(--brass); border-radius: 14px 14px 14px 4px; background: #2d2033; font: 15px/1.35 var(--display); box-shadow: var(--shadow); transform: translate(-10%, -100%); pointer-events: none; }
+.bubble b { display: block; font: 600 12px var(--body); color: var(--gold); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 2px; }
+
+.float-text { position: absolute; left: 0; top: 0; font: 600 18px var(--display); text-shadow: 0 2px 6px #000; white-space: nowrap; }
+.float-text.coin { color: var(--gold-bright); }
+.float-text.crop { color: #ffd0a0; }
+.float-text.water { color: #a9dcff; }
+.float-text.spark { color: #ffe08a; font-size: 26px; }
+
+/* Floating actions: shown only when they can be used */
+.actions { position: fixed; z-index: 15; right: 8px; left: calc(var(--rail-w) + 8px); bottom: calc(var(--dock-h) + 8px); display: flex; justify-content: flex-end; gap: 8px; pointer-events: none; flex-wrap: wrap; }
+.action { pointer-events: auto; min-height: 48px; display: inline-flex; align-items: center; gap: 8px; padding: 0 16px 0 10px; border: 1px solid var(--edge); border-radius: 999px; background: var(--panel-glass); box-shadow: var(--shadow); font-weight: 600; font-size: 15px; }
+.action b { min-width: 26px; height: 26px; display: inline-grid; place-items: center; padding: 0 7px; border-radius: 999px; background: rgba(10, 6, 16, .55); color: var(--gold-bright); font-size: 12px; }
+.action.gold, .button.gold { border-color: var(--gold); background: linear-gradient(160deg, #b0703a, #6d4130); color: #fff0d2; }
+.action:active { transform: translateY(1px); }
+
+/* Navigation: dock on portrait phones, rail elsewhere */
+.dock { position: fixed; z-index: 30; left: 0; right: 0; bottom: 0; height: var(--dock-h); display: flex; justify-content: space-around; padding: 6px 8px env(safe-area-inset-bottom); background: var(--panel); border-top: 1px solid var(--edge-soft); }

+    spooky: item.id === "kitchen-oven" ? 2 : 1,
+    collection: "kitchen-workshop"
+  })));
+  var KITCHEN_EQUIPMENT_BY_ID = Object.freeze(Object.fromEntries(KITCHEN_EQUIPMENT.map((item) => [item.id, item])));
+  var KITCHEN_CAPABILITIES = Object.freeze(Object.fromEntries([
+    ...KITCHEN_EQUIPMENT.map((item) => [item.id, item.grants]),
+    ["copper-range", ["hob", "oven", "tray", "pot", "pan"]],
+    ["copper-pan-rail", ["pan"]],
+    ["iron-utensil-rack", ["pan", "pot"]],
+    ["gothic-spice-cabinet", ["spice"]]
+  ].map(([id, grants]) => [id, Object.freeze(grants)])));
+  var KITCHEN_CAPABILITY_NAMES = Object.freeze({
+    hob: "Hob",
+    oven: "Oven",
+    pot: "Cooking pot",
+    pan: "Frying pan",
+    tray: "Baking tray",
+    spice: "Spice preparation"
+  });
+
+  // src/rules/home-goals.js
+  var HOME_ACTIVITY_KINDS = Object.freeze(["visit", "wardrobe", "cook", "decorate", "plant", "water", "harvest"]);
+  var freshHomeActivities = () => Object.fromEntries(HOME_ACTIVITY_KINDS.map((id) => [id, 0]));
+  var count = (n) => Number.isSafeInteger(n) && n >= 0 ? Math.min(n, 1e6) : 0;
+  var pieces = (s) => Array.isArray(s.house?.placed) ? s.house.placed : [];
+  var activity = (s, kind) => count(s.progression?.homeActivities?.[kind]);
+  var tools2 = (s) => new Set(pieces(s).filter((p) => p.room === "kitchen").flatMap((p) => KITCHEN_CAPABILITIES[p.id] ?? []));
+  var rooms = (s) => new Set(pieces(s).map((p) => p.room)).size;
+  var books = (s) => pieces(s).reduce((n, p) => n + (Array.isArray(p.books) ? p.books.length : 0), 0);

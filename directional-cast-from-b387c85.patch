+.table-row h4 { margin: 0; font: 600 14px var(--body); color: var(--ink-soft); }
+.tip { display: flex; gap: 10px; align-items: center; padding: 10px; border: 1px dashed var(--edge); border-radius: 14px; background: rgba(0, 0, 0, .15); }
+.tip p { font: 15px/1.35 var(--display); color: var(--ink) !important; }

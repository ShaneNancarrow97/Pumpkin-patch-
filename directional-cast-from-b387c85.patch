+.build-pick{position:relative;display:grid;place-items:center;aspect-ratio:1;min-height:0!important;padding:0;border:0;border-radius:12px;background:radial-gradient(circle at 50% 38%,#f3e8f8 0,#d9cbe3 48%,#a996b9 100%);box-shadow:inset 0 -6px 14px #4a3a5a55,inset 0 1px #fff8;overflow:hidden}
+.build-tile.owned .build-pick{background:radial-gradient(circle at 50% 38%,#fbf1df 0,#e8d4b4 48%,#b89a74 100%)}
+.build-pick .thumb{background:transparent!important;border:0!important;box-shadow:none!important;width:100%!important;height:100%!important;display:grid!important;place-items:center}

@@ -0,0 +1,80 @@
+/* A single quiet management surface: station first, optional depth below. */
+.hayride-sheet { display:flex; flex-direction:column; gap:12px; min-width:0; font-variant-numeric:tabular-nums; }
+.hayride-sheet h3, .hayride-sheet h4 { margin:0; color:var(--ink); font:600 14px/1.35 var(--body); }
+.hayride-sheet p, .hayride-sheet small { font-size:12px; line-height:1.45; color:var(--ink-soft); }
+.hayride-sheet .hayride-note { font-size:12px; line-height:1.5; color:var(--ink-soft); }
+.hayride-kicker { margin:0 0 5px; font-size:12px; color:var(--ink-soft); }
+.hayride-welcome { display:grid; grid-template-columns:44px minmax(0,1fr); gap:12px; align-items:start; }
+.hayride-welcome .wide { grid-column:1/-1; }
+.hayride-welcome h3 { margin:0 0 5px; font:600 20px/1.15 var(--display); color:var(--gold-bright); }
+.hayride-mark { display:grid; place-items:center; width:44px; height:44px; border-radius:12px; background:#130c1840; }
+.hayride-mark .premium-icon { width:36px; height:36px; flex-basis:36px; }
+.hayride-preview { display:flex; flex-wrap:wrap; gap:6px; }
+.hayride-preview span { border:1px solid var(--edge-soft); border-radius:8px; padding:6px 8px; color:var(--ink-soft); font-size:12px; }
+.hayride-heading { display:flex; align-items:center; justify-content:space-between; gap:10px; }
+.hayride-heading > div { min-width:0; }
+.hayride-status { display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600; color:var(--ink-soft); }
+.hayride-status i { width:6px; height:6px; border-radius:50%; background:#8e8094; }
+.hayride-status.is-open { color:#c7d8aa; }
+.hayride-status.is-open i { background:#b3c995; box-shadow:0 0 7px #b3c93828; }
+.hayride-open[aria-pressed="true"] { border-color:#b9c99545; background:#b9c9950b; color:#d6e5bd; }
+.hayride-platform { padding:12px; border:1px solid #b69b722c; border-radius:14px; background:linear-gradient(135deg,#b58b4b10,#15101c60); }
+.hayride-platform-title, .hayride-platform-foot, .hayride-section-title { display:flex; align-items:center; justify-content:space-between; gap:10px; }
+.hayride-platform-title span, .hayride-platform-foot, .hayride-section-title > span { font-size:12px; color:var(--ink-soft); }
+.hayride-platform-title span { white-space:nowrap; }
+.hayride-platform > p { margin-top:3px; }
+.hayride-platform progress { display:block; width:100%; height:4px; margin:12px 0 3px; appearance:none; border:0; border-radius:5px; overflow:hidden; background:#0c08183b; }
+.hayride-platform progress::-webkit-progress-bar { background:#0c08183b; border-radius:5px; }

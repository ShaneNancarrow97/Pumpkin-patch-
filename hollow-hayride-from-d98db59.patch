+  const state={hayride:{...freshHayride(),purchased:true},visitors:[],upgrades:{plots:0},coins:1234};
+  const signBoard=()=>new THREE.Group(),controller=createHayrideWorld({scene,state,world:{group:legacy},signBoard});

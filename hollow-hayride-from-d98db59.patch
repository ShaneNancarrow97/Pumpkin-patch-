+  assert.ok(hayrideJourneyTiming({spot:0},"arrival").approachSeconds>10);assert.ok(hayrideJourneyTiming({spot:0},"after").approachSeconds>hayrideJourneyTiming({spot:0},"arrival").approachSeconds);

+body.hayride-ride-active { --dock-h:0px; --rail-w:0px; }
+body.hayride-ride-active :is(#hud,#goal,#streak,#paused,#notice,#bubble,#dialogue,#place-bar,#piece-bar,#actions,#dock,#sheet,#level-celebration,#stock-popover,#fx,.building-context,.foyer-build-tools,.foyer-controls,.npc-reward,.guest-card,.float-text,.paused) { display:none !important; }
+.hayride-ride-ui { position:fixed; z-index:92; inset:0; pointer-events:none; color:var(--ink,#f4e6d1); font-size:14px; }
+.hayride-ride-ui[hidden] { display:none; }
+.hayride-ride-ui button { min-height:44px; min-width:44px; border:1px solid transparent; border-radius:11px; background:transparent; color:inherit; font:inherit; cursor:pointer; pointer-events:auto; }
+.hayride-ride-ui button:hover { background:#513749; }
+.hayride-ride-ui button svg { width:18px; height:18px; flex:none; }
+.hayride-ride-ui button:focus-visible { outline:2px solid #e3b771; outline-offset:2px; }
+.hayride-ride-hud { position:absolute; top:max(10px,env(safe-area-inset-top)); left:max(8px,env(safe-area-inset-left)); right:max(8px,env(safe-area-inset-right)); margin:auto; width:max-content; max-width:calc(100% - 16px); display:flex; gap:4px; align-items:center; padding:4px; border:1px solid #ae865b38; border-radius:17px; background:#201824e8; box-shadow:0 4px 20px #08040c65; transition:opacity .5s ease; }
+.hayride-ride-hud button { display:flex; align-items:center; justify-content:center; gap:5px; padding:6px 10px; font-size:13px; }
+.hayride-ride-place { max-width:230px; min-width:60px; padding:0 12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font:600 15px/1.3 var(--display,Georgia,serif); color:#e8c897; }
+.hayride-ride-ui.idle .hayride-ride-hud { opacity:.3; }
+.hayride-ride-progress { position:absolute; top:0; left:0; right:0; height:3px; background:#0a061170; }
+.hayride-ride-progress i { display:block; height:100%; transform-origin:left; background:#d6ae70; }
+.hayride-ride-vignette { position:absolute; inset:0; background:radial-gradient(ellipse at 50% 46%,transparent 45%,#09051055 85%,#06030b9c); }
+.hayride-ride-shade { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; padding:max(16px,env(safe-area-inset-top)) max(16px,env(safe-area-inset-right)) max(16px,env(safe-area-inset-bottom)) max(16px,env(safe-area-inset-left)); background:#09061078; pointer-events:auto; }
+.hayride-ride-panel { width:min(100%,410px); max-height:100%; overflow:auto; overscroll-behavior:contain; padding:24px; border:1px solid #b08a5b78; border-radius:20px; background:linear-gradient(145deg,#312237fa,#1d1724fc); box-shadow:0 18px 65px #08050a8c; }
+.hayride-ride-panel h2 { margin:5px 0 12px; font:600 27px/1.15 var(--display,Georgia,serif); color:#f0d19c; }
+.hayride-ride-panel p { margin:0 0 12px; font-size:14px; line-height:1.55; }
+.hayride-ride-panel .hayride-ride-eyebrow { margin:0; color:#d0ab78; font-size:12px; font-weight:600; }
+.hayride-ride-muted { color:#c9b9cc; }
+.hayride-ride-settings { display:grid; gap:2px; padding:6px 0 10px; border-top:1px solid #ae865b29; }
+.hayride-ride-settings button { display:flex; align-items:center; justify-content:space-between; padding:6px 9px; text-align:left; }
+.hayride-ride-settings b { color:#e7bd80; font-size:12px; }
+.hayride-ride-buttons { display:grid; gap:8px; }
+.hayride-ride-buttons button { padding:9px 14px; border-color:#a789633d; background:#453048; font-weight:600; }
+.hayride-ride-buttons button.is-primary { background:linear-gradient(145deg,#bf8c4e,#8c5431); border-color:#e2b46c; color:#fff1d8; }
+.hayride-ride-summary { display:flex; gap:14px; margin:4px 0 18px; padding:12px 0; border-block:1px solid #ae865b29; color:#c9b9cc; font-size:12px; }
+.hayride-ride-summary span { flex:1; }
+.hayride-ride-summary b { display:block; color:#efcd92; font:600 24px/1.3 var(--display,Georgia,serif); }
+.hayride-ride-hint { position:absolute; bottom:max(16px,env(safe-area-inset-bottom)); left:0; right:0; margin:0; text-align:center; color:#ebdcc6; font-size:12px; text-shadow:0 1px 8px #000; animation:hayride-hint 6s forwards; }
+.hayride-ride-cue { position:absolute; bottom:max(48px,calc(env(safe-area-inset-bottom) + 40px)); left:50%; transform:translateX(-50%) translateY(4px); max-width:calc(100% - 32px); width:max-content; margin:0; padding:8px 15px; border-radius:18px; background:#1c1329d9; color:#efd8af; font:600 15px/1.3 var(--display,Georgia,serif); opacity:0; transition:opacity .35s,transform .35s; }
+.hayride-ride-cue.show { opacity:1; transform:translateX(-50%); }
+@keyframes hayride-hint { 0%,60%{opacity:.9}100%{opacity:0} }
+@media(max-width:540px) { .hayride-ride-hud { width:calc(100% - 16px); gap:0; }.hayride-ride-place { min-width:0; flex:1; padding:0 5px; font-size:13px; }.hayride-ride-hud button { padding:5px 7px; flex-shrink:0; }.hayride-ride-panel { padding:20px; }.hayride-ride-panel h2 { font-size:24px; }.hayride-ride-hud button:not(:first-child) span { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); } }
+@media(max-height:460px) { .hayride-ride-panel { width:min(100%,510px); padding:16px 20px; }.hayride-ride-panel p { margin-bottom:8px; }.hayride-ride-panel h2 { font-size:23px; margin-bottom:8px; }.hayride-ride-settings { grid-template-columns:1fr 1fr; padding:4px 0 8px; }.hayride-ride-buttons { grid-template-columns:1fr 1fr; } }
+@media(prefers-reduced-motion:reduce) { .hayride-ride-ui * { animation:none !important; transition:none !important; }.hayride-ride-hint { display:none; } }
diff --git a/voxel/src/ui/hayride-sheet.js b/voxel/src/ui/hayride-sheet.js

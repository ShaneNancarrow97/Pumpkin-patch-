+function prepared() { return { hayride: H.freshHayride(), hollowHouse: { purchased: true, status: "ready" }, coins: 100000, earned: 200000, progression: { bonusEarned: 0 }, visitors: [], holds: [], time: 0, nextVisitor: 0, paused: false }; }

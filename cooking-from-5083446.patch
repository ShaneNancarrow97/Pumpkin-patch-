+@media (max-width: 380px) {
+  .cooking-sheet .cooking-art { width: 44px; height: 44px; flex-basis: 44px; }
+  .cooking-recipe { grid-template-columns: 44px minmax(0, 1fr); }
+  .cooking-food-row { grid-template-columns: minmax(0, 1fr) auto; }
+  .cooking-food-row > .cooking-art { display: none; }
+  .cooking-pantry { grid-template-columns: minmax(0, 1fr); }
+}
+@media (max-height: 480px) {
+  .cooking-sheet { gap: 12px; }
+  .cooking-welcome { padding: 12px; }
+}

+  tick(a, 300); for (let i = 0; i < 300; i++) { V.visitorEventUpgradeCost(b, "rush"); tick(b, 1); }
+  assert.deepEqual(a.visitorEvents, b.visitorEvents); const original = JSON.stringify(a.visitorEvents);

+.hayride-ride-panel h2 { margin:5px 0 12px; font:600 27px/1.15 var(--display,Georgia,serif); color:#f0d19c; }
+.hayride-ride-panel p { margin:0 0 12px; font-size:14px; line-height:1.55; }
+.hayride-ride-panel .hayride-ride-eyebrow { margin:0; color:#d0ab78; font-size:12px; font-weight:600; }
+.hayride-ride-muted { color:#c9b9cc; }
+.hayride-ride-settings { display:grid; gap:2px; padding:6px 0 10px; border-top:1px solid #ae865b29; }

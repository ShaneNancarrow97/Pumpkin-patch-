+.hayride-ride-place { max-width:230px; min-width:60px; padding:0 12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font:600 15px/1.3 var(--display,Georgia,serif); color:#e8c897; }
+.hayride-ride-ui.idle .hayride-ride-hud { opacity:.3; }
+.hayride-ride-progress { position:absolute; top:0; left:0; right:0; height:3px; background:#0a061170; }
+.hayride-ride-progress i { display:block; height:100%; transform-origin:left; background:#d6ae70; }

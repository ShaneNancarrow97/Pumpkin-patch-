@@ -0,0 +1,507 @@
+{
+  "version": 1,
+  "status": "proposal",
+  "integrationStatus": "not-installed",
+  "title": "Three evenings worth preparing for",
+  "scope": "Content and reward briefs for Claude to integrate. No festival runtime, save fields, visitor spawns, reward grants or economy changes are installed by this file.",
+  "policy": {
+    "preparation": "untimed",
+    "completion": "choose-any-three-of-four-goals",
+    "targets": "Suggested tuning values; not balanced or advertised as guaranteed completion times.",
+    "guestBudget": "Use each visitor's existing finite wallet; an event never creates a second purse.",
+    "guestCapacity": "Use existing invitation and queue systems within their current caps.",
+    "pause": "Freeze operational counters and clocks with the game.",
+    "offline": "No deadline expiry, failure penalty or event simulation while the game is closed.",
+    "restart": "Allow ending and trying another evening without resetting the farm, home or permanent progress.",
+    "rewards": "One permanent cosmetic unlock per theme. Further completions may record an evening in a future event history; they do not grant duplicate items, coins, currency or automatic stat bonuses.",
+    "counting": "Consume authoritative completed transactions/outcomes for the selected evening. Deduplicate by source plus receipt/visit ID; distinct-guest goals additionally deduplicate by guest ID. Never infer success from an NPC disappearing off screen."
+  },
+  "metricDefinitions": {
+    "food-servings": {
+      "unit": "servings",
+      "aggregation": "paid-quantity",
+      "adapterRequirement": "Consume confirmed food-payment receipts, filtered to the evening's listed recipe IDs. Count paid servings once, not stock displayed, recipes cooked or money quoted."
+    },
+    "completed-attraction-guests": {
+      "unit": "guests",
+      "aggregation": "distinct-guests",
+      "adapterRequirement": "Record actual paid maze/hayride completion outcomes. A guest counts once for this goal even if they repeat the maze or use both attractions."
+    },
+    "vip-served-guests": {
+      "unit": "VIP guests",
+      "aggregation": "distinct-guests",
+      "adapterRequirement": "Join an existing VIP guest flag to a confirmed paid food or attraction receipt from the evening. Arrival alone and free owner ride-alongs do not qualify."
+    },
+    "happy-departures": {
+      "unit": "guests",
+      "aggregation": "distinct-guests",
+      "adapterRequirement": "Sample the visitor's real happiness at their confirmed final departure, before removing their state. Apply the configured threshold. Do not count a temporary return from a ride as a departure."
+    },
+    "cocoa-servings": {
+      "unit": "drinks",
+      "aggregation": "paid-quantity",
+      "adapterRequirement": "Consume confirmed Sandy stand receipts for cocoa or the listed cocoa specials. Supplying stock, a quote or the cashier animation is not a sale."
+    },
+    "garden-harvest-quantity": {
+      "unit": "ingredients",
+      "aggregation": "successful-harvest-quantity",
+      "adapterRequirement": "Consume successful harvest results from the listed garden crop pieces after choosing the evening. Count harvested quantity once whether it enters the pantry or sells as overflow; later cooking is a separate transaction."
+    },
+    "extended-hayride-guests": {
+      "unit": "guests",
+      "aggregation": "distinct-guests",
+      "adapterRequirement": "At paid departure, capture the convoy's actual routeLevel. Count a guest only after completing that captured route, not because a route upgrade was bought mid-journey."
+    },
+    "short-queue-completions": {
+      "unit": "guests",
+      "aggregation": "distinct-guests",
+      "adapterRequirement": "Capture each visitor's queue wait before boarding/admission and join it to their paid completion outcome. Use the configured maximum wait; never reset waiting time when a second tractor changes boarding bay."
+    }
+  },
+  "themes": [
+    {
+      "id": "midnight-court-banquet",
+      "name": "Midnight Court Banquet",
+      "level": 13,
+      "rewardId": "contract-trophy-banquet-candelabrum",
+      "recipeIds": [
+        "haunted-pie",
+        "moonlight-tart"
+      ],
+      "letter": "Dear keepers of the patch, the Court has heard that your pastry is worth rising for. Set two dishes beneath the lanterns and leave a carriage waiting by the woods. We shall bring our best velvet, our oldest coins, and reasonably good table manners. Yours until dawn, the Midnight Court.",
+      "intendedDecision": "Balance a premium two-dish menu and ticket prices against the same guests' remaining wallets, while keeping both attractions moving.",
+      "preparation": [
+        "Bake Haunted harvest pie and Moonlight tart in the home kitchen, then choose those two shop displays.",
+        "Prepare vegetables from the garden or order a delivery, and leave room in the pantry and finished-food cupboard.",
+        "Open the restored Hollow House and the hayride, then review ticket prices and the existing Midnight Court invitation upgrade."
+      ],
+      "prerequisites": {
+        "houseLevel": 2,
+        "kitchenPurchased": true,
+        "visitorEventIds": [
+          "vip"
+        ],
+        "cocoaTier": 0,
+        "attractions": [
+          {
+            "id": "hollow-house",
+            "minTier": 2,
+            "ready": true
+          },
+          {
+            "id": "hayride",
+            "minTier": 1,
+            "ready": true,
+            "routeLevel": 0
+          }
+        ],
+        "gardenDecorIds": [],
+        "suggestedKitchenEquipmentIds": [
+          "kitchen-oven",
+          "kitchen-baking-rack"
+        ],
+        "kitchenCapabilities": [
+          "oven",
+          "tray"
+        ]
+      },
+      "operation": {
+        "mode": "player-ended",
+        "suggestedMinutes": 20,
+        "hardDeadline": false,
+        "pauseWithGame": true,
+        "offlineSimulation": false,
+        "failurePenalty": "none"
+      },
+      "goals": {
+        "choose": 3,
+        "tuningStatus": "suggested-unbalanced",
+        "options": [
+          {
+            "id": "court-supper",
+            "label": "Sell 12 portions from tonight's two-dish menu",
+            "metricId": "food-servings",
+            "target": 12,
+            "unit": "servings",
+            "window": "session",
+            "conditions": {
+              "recipeIds": [
+                "haunted-pie",
+                "moonlight-tart"
+              ]
+            }
+          },
+          {
+            "id": "court-frights",
+            "label": "Welcome 12 guests through a paid attraction visit",
+            "metricId": "completed-attraction-guests",
+            "target": 12,
+            "unit": "guests",
+            "window": "session",
+            "conditions": {
+              "attractionIds": [
+                "hollow-house",
+                "hayride"
+              ]
+            }
+          },
+          {
+            "id": "court-patrons",
+            "label": "Serve 4 different Midnight Court guests",
+            "metricId": "vip-served-guests",
+            "target": 4,
+            "unit": "VIP guests",
+            "window": "session",
+            "conditions": {
+              "visitorEventId": "vip",
+              "paidSources": [
+                "food",
+                "hollow-house",
+                "hayride"
+              ]
+            }
+          },
+          {
+            "id": "court-goodbyes",
+            "label": "See 10 guests finish their evening happily",
+            "metricId": "happy-departures",
+            "target": 10,
+            "unit": "guests",
+            "window": "session",
+            "conditions": {
+              "minimumHappiness": 75
+            }
+          }
+        ]
+      }
+    },
+    {
+      "id": "lanterns-in-the-mist",
+      "name": "Lanterns in the Mist",
+      "level": 15,
+      "rewardId": "contract-trophy-moonlit-conservatory",
+      "recipeIds": [
+        "harvest-broth",
+        "bramble-crumble"
+      ],
+      "letter": "The mist has reached the village windows, and something gentle is ringing the garden bell. Tonight, keep the broth warm and the lanterns low. A little fright is welcome; a kind welcome is remembered. Meet us where the moonflowers open.",
+      "intendedDecision": "Choose a welcoming food-and-cocoa service and a comfortable scare programme, or spend more time harvesting garden ingredients and completing the harvest alternative.",
+      "preparation": [
+        "Prepare Harvest cauldron broth and Bramble crumble; use garden vegetables, herbs and berries or buy the ingredients.",
+        "Restock Sandy's cocoa and ghost marshmallow cocoa, and review the number of guests waiting for service.",
+        "Choose a few favourite maze effects for the evening and leave a clear route between the attractions and refreshments."
+      ],
+      "prerequisites": {
+        "houseLevel": 2,
+        "kitchenPurchased": true,
+        "visitorEventIds": [],
+        "cocoaTier": 2,
+        "attractions": [
+          {
+            "id": "hollow-house",

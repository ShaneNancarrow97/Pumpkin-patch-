+            "ready": true
+          },
+          {
+            "id": "hayride",
+            "minTier": 2,
+            "ready": true,
+            "routeLevel": 1
+          }
+        ],
+        "gardenDecorIds": [],
+        "suggestedKitchenEquipmentIds": [
+          "kitchen-hob",

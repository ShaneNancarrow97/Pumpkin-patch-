new file mode 100644
index 0000000..ae17749
--- /dev/null
+++ b/voxel/test/hayride-icons.test.mjs
@@ -0,0 +1,53 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { HAYRIDE_TIERS, HAYRIDE_OPERATIONS, HAYRIDE_ROUTE_UPGRADES, HAYRIDE_SCARES } from '../src/content/hayride.js';
+import { HAYRIDE_ICON_GRID, HAYRIDE_ICON_IDS, hayrideIconCell } from '../src/content/hayride-icon-map.js';
+
+test('every actual tractor ride purchase has its own known art cell', () => {
+  const purchases = [
+    ...HAYRIDE_TIERS.map(t => 'tier' + t.level),
+    ...HAYRIDE_OPERATIONS.map(u => u.id),
+    ...HAYRIDE_ROUTE_UPGRADES.map(u => 'route' + u.level),
+    ...HAYRIDE_SCARES.map(u => u.id),
+  ];
+  assert.deepEqual([...purchases].sort(), [...HAYRIDE_ICON_IDS].sort(), 'catalogue changed: provide or retire the corresponding upgrade art');
+  assert.equal(new Set(HAYRIDE_ICON_IDS).size, HAYRIDE_ICON_IDS.length);
+  for (const id of purchases) {
+    const cell = hayrideIconCell(id);
+    assert.ok(cell, id);
+    assert.ok(cell.column >= 0 && cell.column < HAYRIDE_ICON_GRID.columns, id);
+    assert.ok(cell.row >= 0 && cell.row < HAYRIDE_ICON_GRID.rows, id);
+  }
+  for (const unknown of ['not-an-upgrade', '', undefined, null, '__proto__']) assert.equal(hayrideIconCell(unknown), null);
+});
+
+function webpDimensions(bytes) {
+  assert.equal(bytes.toString('ascii', 0, 4), 'RIFF');
+  assert.equal(bytes.toString('ascii', 8, 12), 'WEBP');
+  assert.equal(bytes.readUInt32LE(4) + 8, bytes.length, 'complete RIFF file');
+  for (let p = 12; p + 8 <= bytes.length;) {
+    const type = bytes.toString('ascii', p, p + 4), n = bytes.readUInt32LE(p + 4), start = p + 8;
+    assert.ok(start + n <= bytes.length, 'complete WebP chunk');
+    if (type === 'VP8X') return { width: 1 + bytes.readUIntLE(start + 4, 3), height: 1 + bytes.readUIntLE(start + 7, 3) };
+    if (type === 'VP8L') {
+      assert.equal(bytes[start], 0x2f);
+      const bits = bytes.readUInt32LE(start + 1);
+      return { width: 1 + (bits & 0x3fff), height: 1 + ((bits >>> 14) & 0x3fff) };
+    }
+    if (type === 'VP8 ') {
+      assert.equal(bytes.toString('hex', start + 3, start + 6), '9d012a');
+      return { width: bytes.readUInt16LE(start + 6) & 0x3fff, height: bytes.readUInt16LE(start + 8) & 0x3fff };
+    }
+    p += 8 + n + n % 2;
+  }
+  throw Error('No supported image header');
+}
+
+test('the shipped menu atlas fits the declared cells and a mobile icon budget', () => {
+  const bytes = readFileSync(new URL('../assets/hayride-upgrade-icons.webp', import.meta.url));
+  const { columns, rows, cell } = HAYRIDE_ICON_GRID;
+  assert.deepEqual(webpDimensions(bytes), { width: columns * cell, height: rows * cell });
+  assert.ok(bytes.length < 350 * 1024, 'the icon sheet must not embed a full-size generation');
+  assert.ok(columns * rows * cell * cell * 4 < 2 * 1024 * 1024, 'the menu sheet exceeds 2 MiB decoded');
+});
diff --git a/voxel/tools/bake_hayride_icons.py b/voxel/tools/bake_hayride_icons.py
new file mode 100644
index 0000000..98449e7
--- /dev/null
+++ b/voxel/tools/bake_hayride_icons.py
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Normalize/pack the twelve authored icons; never paint or synthesize art."""
+from pathlib import Path
+import hashlib
+import json
+import numpy as np
+from PIL import Image
+from scipy import ndimage
+
+ROOT = Path(__file__).resolve().parents[1]
+DOC = ROOT / 'docs/plans/hayride-upgrade-icons'
+SOURCE = DOC / 'source.png'
+IDS = ['tier1', 'tier2', 'tier3', 'fleet', 'dispatch', 'route1', 'route2',
+       'turning-scarecrows', 'spider-drop', 'bride-procession', 'spectral-burst', 'bus-breakout']
+source = Image.open(SOURCE).convert('RGBA')
+rgba = np.asarray(source)
+labels, _ = ndimage.label(rgba[:, :, 3] > 64)
+objects = ndimage.find_objects(labels)
+components = []
+for label, box in enumerate(objects, 1):
+    area = int((labels[box] == label).sum())
+    if area > 5000:
+        y, x = box
+        column = min(3, int((x.start + x.stop) / 2 / source.width * 4))
+        row = min(2, int((y.start + y.stop) / 2 / source.height * 3))
+        components.append((row * 4 + column, label, box))
+if len(components) != 12 or sorted(i for i, _, _ in components) != list(range(12)):
+    raise ValueError('Source no longer contains exactly one main icon per atlas cell; review before repacking')
+
+# The source silhouettes slightly overlap in their rectangular bounding boxes.
+# Separate by actual connected alpha, not by slicing through the tractor wheels.
+_, nearest = ndimage.distance_transform_edt(labels == 0, return_indices=True)
+nearest_label = labels[tuple(nearest)]
+atlas = Image.new('RGBA', (768, 576))
+measurements = []
+for index, label, _ in sorted(components):
+    core = labels == label
+    fringe = ndimage.binary_dilation(core, iterations=2) & (nearest_label == label)
+    pixels = rgba.copy()
+    pixels[:, :, 3] = np.where(fringe, pixels[:, :, 3], 0)
+    icon = Image.fromarray(pixels)
+    bounds = icon.getbbox()
+    icon = icon.crop(bounds)
+    scale = min(176 / icon.width, 176 / icon.height)
+    icon = icon.resize((round(icon.width * scale), round(icon.height * scale)), Image.Resampling.LANCZOS)
+    cell = Image.new('RGBA', (192, 192))
+    cell.alpha_composite(icon, ((192 - icon.width) // 2, (192 - icon.height) // 2))
+    atlas.alpha_composite(cell, (index % 4 * 192, index // 4 * 192))
+    measurements.append({'id': IDS[index], 'index': index, 'sourceBounds': bounds,
+                         'packedBounds': cell.getbbox(), 'scale': scale,
+                         'rgbaSHA256': hashlib.sha256(cell.tobytes()).hexdigest()})
+if len({m['rgbaSHA256'] for m in measurements}) != 12:
+    raise ValueError('An icon was duplicated')
+target = ROOT / 'assets/hayride-upgrade-icons.webp'
+atlas.save(target, 'WEBP', quality=88, method=6, exact=True)
+preview = Image.new('RGB', atlas.size, '#211a29')
+preview.paste(atlas, mask=atlas.getchannel('A'))
+preview.save(DOC / 'review.jpg', quality=94)
+(DOC / 'measurements.json').write_text(json.dumps({
+    'sourceSHA256': hashlib.sha256(SOURCE.read_bytes()).hexdigest(),
+    'encodedSHA256': hashlib.sha256(target.read_bytes()).hexdigest(),
+    'encodedBytes': target.stat().st_size, 'width': 768, 'height': 576,
+    'decodedRGBABytes': 768 * 576 * 4, 'icons': measurements,
+}, indent=2) + '\n')
+print(f'Packed12 distinct authored icons: {target.stat().st_size:,} bytes,768×576RGBA')
